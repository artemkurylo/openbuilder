#!/usr/bin/env bash
# openbuilder — operator CLI for the openbuilder control plane.
#
# Runs on the laptop. Plans and reviews locally with Opus 5; drives the EC2
# implementer instance exclusively through AWS Systems Manager (send-command /
# start-session). There is no SSH, no key pair and no inbound rule anywhere in
# this system — if you find yourself wanting `ssh`, you want `openbuilder shell`.
#
# Configuration (plain environment variables, no config file format):
#   OPENBUILDER_INSTANCE_ID   EC2 instance id of the implementer instance.
#                             If unset, falls back to
#                             `terraform -chdir=infra output -raw instance_id`
#                             and caches the answer.
#   OPENBUILDER_REGION        Region the instance lives in. Falls back to the cached
#                             value, then the `region` TF output, then
#                             eu-central-1. Deliberately ignores AWS_REGION:
#                             that variable belongs to your local model
#                             provider and is usually a different region.
#   OPENBUILDER_AWS_PROFILE   Profile used for EC2/SSM calls against the instance.
#                             Set this when your ambient AWS_PROFILE points at
#                             a different account (e.g. one that only serves
#                             the local planner/reviewer model). Unset means
#                             "use whatever the environment already has".
#   OPENBUILDER_TARGET_REPO   Default <owner>/<repo> for `status`.
#   OPENBUILDER_WORKSPACE     Where target repos are cloned.
#                             Default: $HOME/.openbuilder/repos
#   OPENBUILDER_OWNER         Comma-separated allowlist of owners this CLI may
#                             touch; defaults to artemkurylo. An owner not in
#                             the list is refused before any network call.
#   OPENBUILDER_GH_HOST       Asserted, not configurable: only github.com is
#                             supported. Any other value refuses startup.
#
# `./.openbuilder.local` (and `<repo-root>/.openbuilder.local`) is sourced when
# present so you can keep those values next to the checkout. That file is
# gitignored on purpose — it is machine-local operator config, never committed.
# Real environment variables always win over the file.

set -euo pipefail
IFS=$'\n\t'

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

OB_PROG=${0##*/}

# <root>/local/bin/openbuilder -> <root>
OB_BIN_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
OB_ROOT=$(CDPATH='' cd -- "$OB_BIN_DIR/../.." && pwd -P)

OB_CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/openbuilder

# Planning and review happen on the laptop with the big model.
OB_OPUS_MODEL=amazon-bedrock/us.anthropic.claude-opus-5

OB_BRANCH_PREFIX=openbuilder
OB_LABEL_PREFIX=openbuilder

OB_REMOTE_HOME=/opt/openbuilder
OB_REMOTE_LOG=$OB_REMOTE_HOME/log/openbuilder.log
OB_REMOTE_USER=openbuilder

# name|color|description — the six labels from the naming contract.
OB_LABELS=(
    "openbuilder:queued|fbca04|Plan branch pushed; not yet picked up by the instance"
    "openbuilder:in-progress|1d76db|Remote implementer agent is working on it"
    "openbuilder:awaiting-review|5319e7|Pull request is ready for the Opus 5 reviewer"
    "openbuilder:changes-requested|d93f0b|Reviewer wants another implementation round"
    "openbuilder:approved|0e8a16|Human may merge; the instance stops touching it"
    "openbuilder:blocked|b60205|Agent gave up; needs a human"
)

# `logs -f` poll interval, and the byte ceiling we pull per poll. SSM caps the
# inline invocation output, so we bound the chunk remotely and let the next poll
# pick up the rest.
OB_LOG_FOLLOW_INTERVAL=5
OB_LOG_CHUNK_BYTES=16000

# `review --watch` label-poll interval: the instance's poll timer ticks on the
# same cadence, so both sides observe the loop once a minute. Not configurable.
OB_WATCH_INTERVAL=60
# One headless reviewer run is bounded like an instance round (the
# OPENBUILDER_MAX_RUNTIME default in runner/bin/ob-common.sh); the watch loop
# retries until its own round cap instead.
OB_WATCH_MAX_TIME=45m

# ---------------------------------------------------------------------------
# Output helpers
# ---------------------------------------------------------------------------

ob_info() { printf '%s\n' "==> $*" >&2; }
ob_warn() { printf '%s\n' "warning: $*" >&2; }
ob_die() {
    printf '%s\n' "$OB_PROG: $*" >&2
    exit 1
}

ob_need() {
    local cmd
    for cmd in "$@"; do
        command -v "$cmd" >/dev/null 2>&1 ||
            ob_die "required command not found on PATH: $cmd"
    done
}

# ---------------------------------------------------------------------------
# Configuration resolution
# ---------------------------------------------------------------------------

ob_load_local_config() {
    local saved_instance=${OPENBUILDER_INSTANCE_ID:-}
    local saved_region=${OPENBUILDER_REGION:-}
    local saved_repo=${OPENBUILDER_TARGET_REPO:-}
    local saved_workspace=${OPENBUILDER_WORKSPACE:-}
    local saved_profile=${OPENBUILDER_AWS_PROFILE:-}
    local saved_owner=${OPENBUILDER_OWNER:-}
    local candidate previous=''

    for candidate in "$PWD/.openbuilder.local" "$OB_ROOT/.openbuilder.local"; do
        [[ -f $candidate ]] || continue
        # Do not source the same file twice when run from the repo root.
        [[ $candidate == "$previous" ]] && continue
        previous=$candidate
        # shellcheck source=/dev/null
        . "$candidate"
    done

    # Real environment variables outrank the file.
    [[ -n $saved_instance ]] && OPENBUILDER_INSTANCE_ID=$saved_instance
    [[ -n $saved_region ]] && OPENBUILDER_REGION=$saved_region
    [[ -n $saved_repo ]] && OPENBUILDER_TARGET_REPO=$saved_repo
    [[ -n $saved_workspace ]] && OPENBUILDER_WORKSPACE=$saved_workspace
    [[ -n $saved_profile ]] && OPENBUILDER_AWS_PROFILE=$saved_profile
    [[ -n $saved_owner ]] && OPENBUILDER_OWNER=$saved_owner

    OPENBUILDER_INSTANCE_ID=${OPENBUILDER_INSTANCE_ID:-}
    OPENBUILDER_REGION=${OPENBUILDER_REGION:-}
    OPENBUILDER_TARGET_REPO=${OPENBUILDER_TARGET_REPO:-}
    OPENBUILDER_WORKSPACE=${OPENBUILDER_WORKSPACE:-$HOME/.openbuilder/repos}
    OPENBUILDER_AWS_PROFILE=${OPENBUILDER_AWS_PROFILE:-}
    OPENBUILDER_OWNER=${OPENBUILDER_OWNER:-artemkurylo}

    # OPENBUILDER_GH_HOST is an assertion, not a setting: openbuilder is a
    # personal-account tool and github.com is the only supported host (R11).
    OPENBUILDER_GH_HOST=${OPENBUILDER_GH_HOST:-github.com}
    [[ $OPENBUILDER_GH_HOST == github.com ]] ||
        ob_die "OPENBUILDER_GH_HOST is '$OPENBUILDER_GH_HOST'; openbuilder supports github.com only"
    return 0
}

ob_tf_output() {
    local name=$1 value
    command -v terraform >/dev/null 2>&1 || return 1
    [[ -d $OB_ROOT/infra ]] || return 1
    value=$(terraform -chdir="$OB_ROOT/infra" output -raw "$name" 2>/dev/null) || return 1
    [[ -n $value ]] || return 1
    # Before the first apply, `terraform output -raw` prints a multi-line
    # "No outputs found" warning on STDOUT and still exits 0. Treating that as a
    # value produced a malformed --region on every aws call, so reject anything
    # containing whitespace: no output this CLI reads is ever multi-word.
    [[ $value != *[[:space:]]* ]] || return 1
    printf '%s\n' "$value"
}

# Where the INSTANCE lives. Deliberately NOT derived from AWS_REGION or
# AWS_DEFAULT_REGION: those describe the account and region serving the LOCAL
# planner/reviewer model (a Bedrock account in another region, for instance), and
# leaking them here would send every SSM/EC2 call hunting for the instance in the
# wrong region. Only an explicit OPENBUILDER_REGION, the cache, or the Terraform
# output may decide this.
ob_is_region() {
    [[ $1 =~ ^[a-z]{2}(-[a-z]+)+-[0-9]+$ ]]
}

ob_region() {
    local candidate=''

    # An explicit setting wins, but a malformed one is an operator mistake worth
    # shouting about rather than silently papering over with the default.
    if [[ -n $OPENBUILDER_REGION ]]; then
        ob_is_region "$OPENBUILDER_REGION" ||
            ob_die "OPENBUILDER_REGION is not a region: '$OPENBUILDER_REGION'"
        printf '%s\n' "$OPENBUILDER_REGION"
        return 0
    fi

    # The cache is validated too: a bad value written once would otherwise be
    # trusted forever, long after the cause was fixed.
    if [[ -f $OB_CACHE_DIR/region ]]; then
        candidate=$(<"$OB_CACHE_DIR/region")
        ob_is_region "$candidate" || candidate=''
    fi

    if [[ -z $candidate ]]; then
        candidate=$(ob_tf_output region || true)
        ob_is_region "$candidate" || candidate=''
        if [[ -n $candidate ]]; then
            mkdir -p "$OB_CACHE_DIR"
            printf '%s\n' "$candidate" >"$OB_CACHE_DIR/region"
        fi
    fi

    [[ -n $candidate ]] || candidate=eu-central-1
    OPENBUILDER_REGION=$candidate
    printf '%s\n' "$candidate"
}

# Every AWS call for the instance goes through here, explicitly scoped to the instance's
# account and region. The surrounding shell is often pinned to a different
# profile/region for the local model provider, and that must not bleed into
# instance management. Set OPENBUILDER_AWS_PROFILE when the instance lives in an
# account other than your ambient AWS_PROFILE.
ob_aws() {
    local region
    region=$(ob_region)
    if [[ -n ${OPENBUILDER_AWS_PROFILE:-} ]]; then
        AWS_PROFILE="$OPENBUILDER_AWS_PROFILE" \
            AWS_REGION="$region" AWS_DEFAULT_REGION="$region" \
            command aws "$@"
    else
        AWS_REGION="$region" AWS_DEFAULT_REGION="$region" command aws "$@"
    fi
}

# Resolve the instance id: environment, then cache, then Terraform output.
ob_instance_id() {
    if [[ -n $OPENBUILDER_INSTANCE_ID ]]; then
        printf '%s\n' "$OPENBUILDER_INSTANCE_ID"
        return 0
    fi
    if [[ -f $OB_CACHE_DIR/instance-id ]]; then
        OPENBUILDER_INSTANCE_ID=$(<"$OB_CACHE_DIR/instance-id")
        if [[ -n $OPENBUILDER_INSTANCE_ID ]]; then
            printf '%s\n' "$OPENBUILDER_INSTANCE_ID"
            return 0
        fi
    fi
    OPENBUILDER_INSTANCE_ID=$(ob_tf_output instance_id || true)
    # Never cache anything that is not actually an instance id.
    if [[ ! $OPENBUILDER_INSTANCE_ID =~ ^i-[0-9a-f]{8,}$ ]]; then
        OPENBUILDER_INSTANCE_ID=''
    fi
    if [[ -n $OPENBUILDER_INSTANCE_ID ]]; then
        mkdir -p "$OB_CACHE_DIR"
        printf '%s\n' "$OPENBUILDER_INSTANCE_ID" >"$OB_CACHE_DIR/instance-id"
        printf '%s\n' "$OPENBUILDER_INSTANCE_ID"
        return 0
    fi
    ob_die "cannot resolve the implementer instance id.
  Do one of:
    * export OPENBUILDER_INSTANCE_ID=i-0123456789abcdef0
    * put OPENBUILDER_INSTANCE_ID=... in ./.openbuilder.local
    * run 'make apply' in $OB_ROOT so 'terraform -chdir=infra output -raw instance_id' resolves
  (cached value, if any, lives at $OB_CACHE_DIR/instance-id)"
}

ob_repo_arg() {
    local repo=${1:-}
    [[ -n $repo ]] || repo=$OPENBUILDER_TARGET_REPO
    [[ -n $repo ]] ||
        ob_die "no repository given and OPENBUILDER_TARGET_REPO is unset"
    ob_validate_repo "$repo"
    printf '%s\n' "$repo"
}

ob_validate_repo() {
    local repo=$1 owner entry
    local -a allowed=()
    [[ $repo =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] ||
        ob_die "not a valid <owner>/<repo>: $repo"
    owner=${repo%%/*}
    IFS=',' read -r -a allowed <<<"$OPENBUILDER_OWNER"
    for entry in "${allowed[@]}"; do
        [[ -n $entry ]] || continue
        [[ $entry == "$owner" ]] && return 0
    done
    ob_die "refusing $repo: owner '$owner' is not in OPENBUILDER_OWNER ($OPENBUILDER_OWNER)"
}

ob_validate_slug() {
    [[ $1 =~ ^[a-z0-9][a-z0-9-]{1,48}$ ]] ||
        ob_die "invalid slug '$1' (must match ^[a-z0-9][a-z0-9-]{1,48}\$)"
}

ob_validate_pr() {
    [[ $1 =~ ^[0-9]+$ ]] || ob_die "not a pull request number: $1"
}

# owner/repo -> owner__repo, the on-disk key used by both sides of the system.
ob_repo_key() { printf '%s\n' "${1/\//__}"; }

# ---------------------------------------------------------------------------
# Remote execution — everything goes through SSM, never SSH
# ---------------------------------------------------------------------------

# ob_ssm_exec <script>
#
# Runs <script> on the instance with the AWS-RunShellScript SSM document, polls
# `aws ssm list-command-invocations` until the invocation reaches a terminal
# state, writes remote stdout to our stdout and remote stderr to our stderr,
# and returns the remote script's real exit status.
#
# AWS-RunShellScript is the AWS-managed document that runs a list of shell
# commands as root via the SSM agent. The command payload is handed over as
# --cli-input-json built by jq, so no operator input is ever concatenated into
# a shell string or passed through eval.
ob_ssm_exec() {
    local script=$1
    local timeout=${2:-600}
    local region instance payload command_id json status rc out err

    ob_need aws jq
    region=$(ob_region)
    instance=$(ob_instance_id)

    payload=$(jq -n \
        --arg instance "$instance" \
        --arg script "$script" \
        --argjson timeout "$timeout" \
        '{
            InstanceIds: [$instance],
            DocumentName: "AWS-RunShellScript",
            Comment: "openbuilder cli",
            TimeoutSeconds: $timeout,
            Parameters: { commands: [$script] }
        }')

    command_id=$(ob_aws ssm send-command \
        --region "$region" \
        --cli-input-json "$payload" \
        --query 'Command.CommandId' \
        --output text) ||
        ob_die "aws ssm send-command failed (is the instance running and SSM-managed? try '$OB_PROG start')"

    while :; do
        json=$(ob_aws ssm list-command-invocations \
            --region "$region" \
            --command-id "$command_id" \
            --instance-id "$instance" \
            --details \
            --output json) || ob_die "aws ssm list-command-invocations failed"
        status=$(jq -r '.CommandInvocations[0].Status // "Pending"' <<<"$json")
        case $status in
        Success | Failed | Cancelled | TimedOut | Undeliverable | Terminated | DeliveryTimedOut | ExecutionTimedOut)
            break
            ;;
        esac
        sleep 2
    done

    # `Output` is stdout+stderr merged for display; when the plugin reports the
    # streams separately, prefer real stdout so parsed output stays clean.
    out=$(jq -r '.CommandInvocations[0].CommandPlugins[0].StandardOutputContent // ""' <<<"$json")
    if [[ -z $out ]]; then
        out=$(jq -r '.CommandInvocations[0].CommandPlugins[0].Output // ""' <<<"$json")
    fi
    err=$(jq -r '.CommandInvocations[0].CommandPlugins[0].StandardErrorContent // ""' <<<"$json")
    rc=$(jq -r '.CommandInvocations[0].CommandPlugins[0].ResponseCode // -1' <<<"$json")

    [[ -n $out ]] && printf '%s' "$out"
    [[ -n $err ]] && printf '%s' "$err" >&2

    if [[ $status != Success && $rc == "-1" ]]; then
        ob_warn "SSM invocation ended with status $status"
        return 1
    fi
    [[ $rc == "-1" ]] && rc=0
    return "$rc"
}

# Run something as the openbuilder service user with its environment file.
ob_remote_as_user() {
    printf 'set -o allexport; . %s/etc/openbuilder.env; set +o allexport; exec sudo -u %s -E %s\n' \
        "$OB_REMOTE_HOME" "$OB_REMOTE_USER" "$1"
}

# ---------------------------------------------------------------------------
# Instance power
# ---------------------------------------------------------------------------

ob_instance_state() {
    local region instance
    region=$(ob_region)
    instance=$(ob_instance_id)
    ob_aws ec2 describe-instances \
        --region "$region" \
        --instance-ids "$instance" \
        --query 'Reservations[0].Instances[0].State.Name' \
        --output text
}

ob_ssm_online() {
    local region instance count
    region=$(ob_region)
    instance=$(ob_instance_id)
    count=$(ob_aws ssm describe-instance-information \
        --region "$region" \
        --filters "Key=InstanceIds,Values=$instance" \
        --query 'length(InstanceInformationList[?PingStatus==`Online`])' \
        --output text 2>/dev/null || printf '0')
    [[ $count == "1" ]]
}

ob_wait_ssm_online() {
    local tries=${1:-60} i
    for ((i = 0; i < tries; i++)); do
        if ob_ssm_online; then
            return 0
        fi
        sleep 5
    done
    return 1
}

# Idempotent: no-op when the instance is already running.
ob_ensure_running() {
    local region instance state
    ob_need aws
    region=$(ob_region)
    instance=$(ob_instance_id)
    state=$(ob_instance_state)

    case $state in
    running)
        ob_info "instance $instance already running"
        ;;
    pending)
        ob_info "instance $instance is starting; waiting"
        ob_aws ec2 wait instance-running --region "$region" --instance-ids "$instance"
        ;;
    stopped | stopping)
        if [[ $state == stopping ]]; then
            ob_info "instance $instance is stopping; waiting for it to settle"
            ob_aws ec2 wait instance-stopped --region "$region" --instance-ids "$instance"
        fi
        ob_info "starting instance $instance"
        ob_aws ec2 start-instances --region "$region" --instance-ids "$instance" >/dev/null
        ob_aws ec2 wait instance-running --region "$region" --instance-ids "$instance"
        ;;
    *)
        ob_die "instance $instance is in state '$state'; cannot use it"
        ;;
    esac

    if ! ob_wait_ssm_online 60; then
        ob_warn "instance is running but the SSM agent has not reported Online yet; remote commands may fail for another minute"
        return 0
    fi
    ob_info "instance $instance is running and SSM-managed"
}

# ---------------------------------------------------------------------------
# GitHub helpers
# ---------------------------------------------------------------------------

# ob_gh <args...> — run the GitHub CLI pinned to github.com. Its host otherwise
# comes from the ambient GH_HOST or the cwd's git remote, and this laptop's
# CLI is authenticated to more than one host. openbuilder is a personal-account
# tool; the host must not come from the environment (R11), so pin it in the
# child environment only and return the CLI's own exit status.
ob_gh() {
    GH_HOST=github.com gh "$@"
}

ob_ensure_labels() {
    local repo=$1 spec name color desc
    ob_need gh
    for spec in "${OB_LABELS[@]}"; do
        IFS='|' read -r name color desc <<<"$spec"
        if ob_gh label create "$name" \
            --repo "$repo" --color "$color" --description "$desc" >/dev/null 2>&1; then
            ob_info "created label $name"
        else
            # Already there (or a color drift) — converge, never fail.
            ob_gh label edit "$name" \
                --repo "$repo" --color "$color" --description "$desc" >/dev/null 2>&1 || true
        fi
    done
}

ob_pr_labels() {
    ob_gh pr view "$2" --repo "$1" --json labels --jq '.labels[].name' 2>/dev/null || true
}

# ob_pr_relabel <repo> <pr> <add> <remove-csv>
#
# Only labels actually present are passed to --remove-label, so a second
# invocation is a clean no-op instead of a gh error.
ob_pr_relabel() {
    local repo=$1 pr=$2 add=$3 remove_csv=$4
    local -a args=() to_remove=()
    local label present

    present=$(ob_pr_labels "$repo" "$pr")

    IFS=',' read -r -a to_remove <<<"$remove_csv"
    for label in "${to_remove[@]}"; do
        [[ -n $label ]] || continue
        if printf '%s\n' "$present" | grep -qxF -- "$label"; then
            args+=(--remove-label "$label")
        fi
    done
    [[ -n $add ]] && args+=(--add-label "$add")

    if [[ ${#args[@]} -eq 0 ]]; then
        return 0
    fi
    ob_gh pr edit "$pr" --repo "$repo" "${args[@]}" >/dev/null
}

ob_default_branch() {
    ob_gh repo view "$1" --json defaultBranchRef --jq '.defaultBranchRef.name'
}

# ---------------------------------------------------------------------------
# Local clone / omp asset helpers
# ---------------------------------------------------------------------------

# ob_assert_origin_host <dir> — refuse to touch a clone whose origin points
# anywhere but github.com. A workspace directory reused from another host would
# otherwise receive a fetch (ob_ensure_clone) or a push (cmd_dispatch) against
# that host's remote; this assertion runs before either network call.
ob_assert_origin_host() {
    local dir=$1 url
    url=$(git -C "$dir" remote get-url origin 2>/dev/null) ||
        ob_die "clone at $dir has no 'origin' remote"
    [[ $url =~ ^(https://github\.com/|git@github\.com:|ssh://git@github\.com/) ]] ||
        ob_die "refusing clone $dir: origin is $url, which is not on github.com"
}

ob_clone_dir() {
    printf '%s/%s\n' "$OPENBUILDER_WORKSPACE" "$(ob_repo_key "$1")"
}

ob_ensure_clone() {
    local repo=$1 dir
    dir=$(ob_clone_dir "$repo")
    ob_need git gh
    if [[ -d $dir/.git ]]; then
        ob_assert_origin_host "$dir"
        ob_info "fetching $repo into $dir"
        git -C "$dir" fetch --prune --quiet origin
    else
        mkdir -p "$(dirname "$dir")"
        ob_info "cloning $repo into $dir"
        ob_gh repo clone "$repo" "$dir" -- --quiet
    fi
    printf '%s\n' "$dir"
}

# Make the local planner/reviewer agents, their skills and the guardrail hook
# visible to omp inside the target checkout. omp discovers project agents at
# <cwd>/.omp/agents and pre-hooks at <cwd>/.omp/hooks/pre, so we mirror this
# repo's agent/ tree there and add it to the clone's local git excludes — it is
# tooling, it must never end up in a commit on the target repo.
ob_install_local_assets() {
    local dir=$1
    local exclude="$dir/.git/info/exclude"

    mkdir -p "$dir/.omp/agents" "$dir/.omp/hooks/pre" "$dir/.omp/commands"
    if [[ -d $OB_ROOT/agent/local/agents ]]; then
        cp -R "$OB_ROOT/agent/local/agents/." "$dir/.omp/agents/"
    else
        ob_warn "missing $OB_ROOT/agent/local/agents — planner/reviewer agents will not be available"
    fi
    if [[ -f $OB_ROOT/agent/hooks/pre/guardrails.ts ]]; then
        cp "$OB_ROOT/agent/hooks/pre/guardrails.ts" "$dir/.omp/hooks/pre/guardrails.ts"
    fi
    if [[ -d $OB_ROOT/agent/local/commands ]]; then
        cp -R "$OB_ROOT/agent/local/commands/." "$dir/.omp/commands/"
    else
        ob_warn "missing $OB_ROOT/agent/local/commands — /openbuilder-plan will not be available in the session"
    fi

    mkdir -p "$(dirname "$exclude")"
    touch "$exclude"
    if ! grep -qxF '/.omp/' "$exclude" 2>/dev/null; then
        printf '/.omp/\n' >>"$exclude"
    fi
}

ob_plan_branch() { printf '%s/plan/%s\n' "$OB_BRANCH_PREFIX" "$1"; }
ob_work_branch() { printf '%s/work/%s\n' "$OB_BRANCH_PREFIX" "$1"; }
ob_design_branch() { printf '%s/design/%s\n' "$OB_BRANCH_PREFIX" "$1"; }

# ob_gate <clone-dir> <args...> — run local/bin/ob-gate inside the clone, so its
# own `git rev-parse --show-toplevel` resolves to the target repository. The
# gate's exit code is the interface (RFC §3.4): 0 intact, 1 operational refusal,
# 2 usage, 3 void, 4 absent. Returned unchanged; no logging here.
ob_gate() {
    local dir=$1
    shift
    ( cd "$dir" && "$OB_BIN_DIR/ob-gate" "$@" )
}

# ob_need_gate — refuse when the gate is missing. There is no graceful
# degradation: every call site reads its exit code, so absence must be a dead
# stop with a message that names the missing piece.
ob_need_gate() {
    [[ -x $OB_BIN_DIR/ob-gate ]] ||
        ob_die "local/bin/ob-gate is missing or not executable at $OB_BIN_DIR/ob-gate — the epic gate cannot run without it"
}

# ---------------------------------------------------------------------------
# help
# ---------------------------------------------------------------------------

ob_command_table() {
    cat <<'EOF'
usage: openbuilder <command> [args]

  plan <owner/repo> <epic>          design branch + Opus 5 workflow session for an epic
  dispatch <owner/repo> <slug>      gate the backlog, cut and push the plan branch
  review [--watch] <owner/repo> <pr>  review a pull request with Opus 5; --watch runs every round
  approve <owner/repo> <pr>         label a pull request approved
  request-changes <owner/repo> <pr> ask the instance for another round
  status [owner/repo]               slugs, branches, pull requests, labels
  logs [-f] [-n lines]              tail the instance's operational log over SSM
  shell                             interactive SSM session on the instance
  doctor                            run ob-doctor on the instance
  start                             start the implementer instance
  stop                              stop the implementer instance
  cost                              per-slug model spend from the instance's run.ndjson
  help                              this table

environment: OPENBUILDER_INSTANCE_ID, OPENBUILDER_REGION, OPENBUILDER_AWS_PROFILE,
             OPENBUILDER_TARGET_REPO, OPENBUILDER_WORKSPACE,
             OPENBUILDER_OWNER, OPENBUILDER_GH_HOST
             (./.openbuilder.local is sourced when present; it is gitignored)
EOF
}

cmd_help() {
    ob_command_table
    return 0
}

# ---------------------------------------------------------------------------
# plan
# ---------------------------------------------------------------------------

cmd_plan() {
    local usage="usage: $OB_PROG plan <owner/repo> <epic>"
    [[ $# -eq 2 ]] || ob_die "$usage"
    local repo=$1 epic=$2
    ob_validate_repo "$repo"
    ob_validate_slug "$epic"
    ob_need git gh omp
    ob_need_gate

    local dir branch base current rc
    dir=$(ob_ensure_clone "$repo")
    branch=$(ob_design_branch "$epic")
    base=$(ob_default_branch "$repo")
    current=$(git -C "$dir" rev-parse --abbrev-ref HEAD)

    # Exactly three cases, in this order: already on the design branch (no git
    # command at all — `checkout -B --track` would reset the branch to origin's
    # tip and discard the session's uncommitted work), dirty tree (refuse), and
    # existing-or-new branch. Push only on creation, never on checkout.
    if [[ $current == "$branch" ]]; then
        ob_info "already on design branch $branch"
    elif ! git -C "$dir" diff --quiet || ! git -C "$dir" diff --cached --quiet; then
        ob_die "$dir has uncommitted changes on branch $current; commit or stash them before switching to $branch
  git -C $dir status --short"
    elif git -C "$dir" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
        ob_info "checking out existing design branch $branch"
        git -C "$dir" checkout -B "$branch" --track "origin/$branch" --quiet
    else
        ob_info "creating design branch $branch from origin/$base"
        git -C "$dir" checkout -B "$branch" "origin/$base" --quiet
        git -C "$dir" push --quiet --set-upstream origin "$branch"
        ob_info "pushed $branch to origin"
    fi

    ob_install_local_assets "$dir"

    # Verify every approval already recorded for the epic. Absent is normal
    # before the first gate (the session starts intake); void is fatal, because
    # the sessions would resume from unapproved text.
    if [[ ! -f $dir/.openbuilder/epics/$epic/state.json ]]; then
        ob_info "no epic directory for $epic yet — the session will start intake"
    else
        rc=0
        ob_gate "$dir" verify "$epic" --all || rc=$?
        case $rc in
        0)
            ob_info "approvals for epic $epic verified"
            ;;
        3)
            ob_die "an approval for epic $epic is void: an approved artifact changed after it was approved.
  Inspect it:   (cd $dir && $OB_BIN_DIR/ob-gate show $epic)
  Re-approve:   (cd $dir && $OB_BIN_DIR/ob-gate record $epic <stage>)"
            ;;
        4)
            ob_info "no approvals recorded for epic $epic yet"
            ;;
        2)
            ob_die "ob-gate rejected 'verify $epic --all' as a usage error (exit 2); the CLI and ob-gate disagree about the command surface"
            ;;
        *)
            ob_die "ob-gate verify $epic --all failed with exit $rc"
            ;;
        esac
    fi

    local seed
    seed=$(
        cat <<EOF
You are running as the openbuilder workflow session for $repo, epic \`$epic\`.

Load the \`openbuilder-workflow\` skill and resume epic \`$epic\`. Do not ask me what
to do first — the skill and the recorded stage decide that.

The epic's durable state is \`.openbuilder/epics/$epic/\` on the current branch
(\`$branch\`): intake.md, prd.md, rfc.md, state.json. Read state.json first and
continue at the stage it names. If that directory does not exist this is a new
epic: run \`$OB_BIN_DIR/ob-gate init $epic --repo $repo\` and start intake.

\`$OB_BIN_DIR/ob-gate\` is the only thing that may write state.json or record an
approval. Never edit state.json by hand, and never record an approval I did not
give in this session.

Never create or push a branch under \`openbuilder/plan/\` — \`openbuilder dispatch\`
does that, and it is the gate that spends money.
EOF
    )

    ob_info "launching omp workflow session ($OB_OPUS_MODEL) in $dir"
    GH_HOST=github.com GH_REPO="$repo" exec omp \
        --cwd "$dir" \
        --model "$OB_OPUS_MODEL" \
        --append-system-prompt "openbuilder workflow session for $repo epic $epic on branch $branch. Artifacts live in .openbuilder/epics/$epic/. Only local/bin/ob-gate writes state.json. Never push a branch under openbuilder/plan/, never merge." \
        "$seed"
}

# ob_epic_of_plan — read plan.md on stdin, print the epic named by its
# '- epic:' bullet (RFC §2). Prints nothing when the line is absent, so callers
# distinguish "no epic" from an unreadable file. Reading stdin is what lets
# cmd_dispatch feed a file and cmd_status feed an API response.
ob_epic_of_plan() {
    awk '/^- epic:/ {print $3; exit}'
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------

cmd_dispatch() {
    local usage="usage: $OB_PROG dispatch <owner/repo> <slug>"
    [[ $# -eq 2 ]] || ob_die "$usage"
    local repo=$1 slug=$2
    ob_validate_repo "$repo"
    ob_validate_slug "$slug"
    ob_need git gh aws jq

    local dir backlog epic design current branch stories rc
    dir=$(ob_clone_dir "$repo")
    backlog=.openbuilder/backlog/$slug

    [[ -d $dir/.git ]] ||
        ob_die "no local clone at $dir — run '$OB_PROG plan $repo <epic>' first"
    ob_assert_origin_host "$dir"

    [[ -d $dir/$backlog ]] ||
        ob_die "$backlog does not exist in $dir — run '$OB_PROG plan $repo <epic>' first"
    [[ -f $dir/$backlog/plan.md ]] ||
        ob_die "$backlog/plan.md is missing — the planner did not finish"

    stories=$(find "$dir/$backlog" -maxdepth 1 -name 'story-*.md' | wc -l | tr -d '[:space:]')
    [[ $stories -gt 0 ]] ||
        ob_die "$backlog contains no story-*.md cards — nothing for the instance to implement"

    # The planner wrote the cards on the design branch; the epic line names the
    # gate record that must cover them. Validate the value so a backticked epic
    # copied from a PRD header fails loudly instead of becoming a path.
    epic=$(ob_epic_of_plan <"$dir/$backlog/plan.md")
    [[ -n $epic ]] ||
        ob_die "$backlog/plan.md has no '- epic:' line; dispatch cannot tell which epic gates this slug.
  Add a line reading exactly '- epic: <epic>' under its first heading (backlog/SCHEMA.md)."
    ob_validate_slug "$epic"

    design=$(ob_design_branch "$epic")
    current=$(git -C "$dir" rev-parse --abbrev-ref HEAD)
    [[ $current == "$design" ]] || ob_die "$dir is on branch $current, not the design branch $design for epic $epic.
  Run: $OB_PROG plan $repo $epic"

    # An approval covers committed bytes only, and ob-gate verify has nothing to
    # say about a file it never recorded. `status --porcelain` catches untracked
    # new story cards too — the exact "no extra story-*.md" case rule 4b checks.
    if [[ -n $(git -C "$dir" status --porcelain -- "$backlog") ]]; then
        ob_die "$backlog has uncommitted or untracked changes in $dir:
  $(git -C "$dir" status --porcelain -- "$backlog")
  An approval covers committed bytes only. Commit these, then re-approve:
    (cd $dir && $OB_BIN_DIR/ob-gate record $epic backlog $slug)"
    fi

    ob_need_gate
    # verify takes the slug so it answers about this slug alone: an epic with
    # *some* recorded backlog approval must not satisfy a different slug's gate.
    rc=0
    ob_gate "$dir" verify "$epic" backlog "$slug" || rc=$?
    case $rc in
    0)
        ob_info "backlog approval for $slug on epic $epic verified"
        ;;
    3)
        ob_die "the recorded backlog approval for $slug no longer matches the files on $design — an artifact changed after it was approved.
  Re-approve this slug, then dispatch again:
    (cd $dir && $OB_BIN_DIR/ob-gate record $epic backlog $slug)"
        ;;
    4)
        ob_die "no backlog approval is recorded for $slug in .openbuilder/epics/$epic/state.json.
  Approve this slug, then dispatch again:
    (cd $dir && $OB_BIN_DIR/ob-gate record $epic backlog $slug)"
        ;;
    2)
        ob_die "ob-gate rejected 'verify $epic backlog $slug' as a usage error (exit 2); the CLI and ob-gate disagree about the command surface"
        ;;
    *)
        ob_die "ob-gate verify $epic backlog $slug failed with exit $rc"
        ;;
    esac

    # The ordering is the whole gate: a plan branch cut before the stage pointer
    # moved carries stage=backlog, which rule 4b declines on every poll pass,
    # logging nothing to the operational log. So record the stage, then prove it
    # landed on the design-branch tip and on origin before cutting anything.
    ob_info "recording stage=dispatched for epic $epic on $design"
    ob_gate "$dir" stage "$epic" dispatched ||
        ob_die "'ob-gate stage $epic dispatched' failed; no plan branch was created"

    local stage_now
    stage_now=$(git -C "$dir" show "$design:.openbuilder/epics/$epic/state.json" | jq -r '.stage')
    [[ $stage_now == dispatched ]] || ob_die "state.json on $design still says stage='$stage_now' after 'ob-gate stage $epic dispatched'; refusing to cut $(ob_plan_branch "$slug"), because rule 4b would decline it on every poll pass forever"

    git -C "$dir" fetch --quiet origin
    [[ $(git -C "$dir" rev-parse "$design") == $(git -C "$dir" rev-parse "origin/$design") ]] ||
        ob_die "$design differs from origin/$design after 'ob-gate stage $epic dispatched'; push it before dispatching:
  git -C $dir push origin $design"

    # Start the instance first: the poll loop is the only trigger, so a stopped
    # instance would otherwise turn a dispatch into a silent no-op.
    ob_ensure_running

    # Cut the plan branch from the design tip without checking it out, so the
    # clone stays on the design branch for the next slug.
    branch=$(ob_plan_branch "$slug")
    if git -C "$dir" show-ref --verify --quiet "refs/remotes/origin/$branch" &&
        ! git -C "$dir" merge-base --is-ancestor "origin/$branch" "$design"; then
        ob_die "origin/$branch already exists and is not an ancestor of $design; pushing it would rewrite history, which openbuilder never does.
  Delete it first if this dispatch is intentional:
    gh api -X DELETE repos/$repo/git/refs/heads/$branch"
    fi
    git -C "$dir" branch -f "$branch" "$design"
    ob_info "created plan branch $branch from $design"
    git -C "$dir" push --quiet --set-upstream origin "$branch"
    ob_info "pushed $branch to origin"

    ob_ensure_labels "$repo"

    cat <<EOF

Dispatched $repo :: $slug
  design branch : $design
  plan branch : $branch  ($stories story cards)
  work branch : $(ob_work_branch "$slug")  (created by the instance)

What happens next, without any further action from you:
  1. Within 60s the instance's openbuilder-poll timer sees $branch.
  2. Rule 4b re-checks the recorded backlog approval against the plan branch. A mismatch is a silent skip — '$OB_PROG status $repo' is where it shows up.
  3. It finds no pull request for $(ob_work_branch "$slug") and runs ob-implement.
  4. On success it pushes the work branch, opens a pull request and labels it
     'openbuilder:awaiting-review'. On failure it labels 'openbuilder:blocked'
     and comments the log tail.

Watch it:  $OB_PROG status $repo
           $OB_PROG logs -f
Then:      $OB_PROG review --watch $repo <pr>
EOF
}

# ---------------------------------------------------------------------------
# review / approve / request-changes
# ---------------------------------------------------------------------------

cmd_review() {
    local usage="usage: $OB_PROG review [--watch] <owner/repo> <pr>"
    local watch=0
    local -a positional=()
    while [[ $# -gt 0 ]]; do
        case $1 in
        --watch)
            watch=1
            shift
            ;;
        -h | --help)
            printf '%s\n' "$usage"
            return 0
            ;;
        -*)
            ob_die "$usage"
            ;;
        *)
            positional+=("$1")
            shift
            ;;
        esac
    done
    set -- "${positional[@]}"
    [[ $# -eq 2 ]] || ob_die "$usage"
    local repo=$1 pr=$2
    ob_validate_repo "$repo"
    ob_validate_pr "$pr"
    ob_need git gh omp aws jq

    # The instance must be up: whatever verdict we post starts the next round.
    ob_ensure_running

    if [[ $watch -eq 1 ]]; then
        ob_review_watch "$repo" "$pr"
        return $?
    fi

    local dir head
    dir=$(ob_ensure_clone "$repo")
    head=$(ob_gh pr view "$pr" --repo "$repo" --json headRefName --jq '.headRefName') ||
        ob_die "cannot read pull request #$pr in $repo"

    if git -C "$dir" show-ref --verify --quiet "refs/remotes/origin/$head"; then
        ob_info "checking out $head for local inspection"
        git -C "$dir" checkout -B "$head" --track "origin/$head" --quiet
        git -C "$dir" reset --hard --quiet "origin/$head"
    else
        ob_warn "origin/$head not found locally; reviewing from the GitHub API only"
    fi

    ob_install_local_assets "$dir"

    local seed
    seed=$(
        cat <<EOF
You are running as the openbuilder reviewer for $repo pull request #$pr
(head branch \`$head\`).

Start by reading \`pr://$pr\` — that gives you the description, the diff and
every existing comment. Then delegate to the \`reviewer\` agent (task tool,
agent: "reviewer") and follow the \`review-openbuilder-pr\` skill.

The pull request was produced by a small model from the story cards in
\`.openbuilder/backlog/\` on the plan branch, and its own notes are in
\`.openbuilder/backlog/<slug>/worklog.md\` on \`$head\`. Check the diff against
the acceptance criteria of every card, not against your own taste.

Finish with exactly one verdict:
  * approve            -> tell me to run: $OB_PROG approve $repo $pr
  * changes-requested  -> post line-anchored review comments that a small model
                          can act on without guessing, then tell me to run:
                          $OB_PROG request-changes $repo $pr

Never merge, never push to $head, never push to a default branch.
EOF
    )

    ob_info "launching omp reviewer ($OB_OPUS_MODEL) in $dir"
    GH_HOST=github.com GH_REPO="$repo" exec omp \
        --cwd "$dir" \
        --model "$OB_OPUS_MODEL" \
        --append-system-prompt "openbuilder reviewer session for $repo pull request #$pr. Read-only on the branch: comment and label, never merge, never push." \
        "$seed"
}

# ob_review_watch <repo> <pr> — carry a pull request to a verdict with nobody at
# the keyboard (RFC §3.6). Poll the labels every OB_WATCH_INTERVAL s and act on
# the first match; review each new head sha exactly once, remembering the last
# reviewed sha in $OB_CACHE_DIR/review/; and hand out at most
# OPENBUILDER_MAX_ATTEMPTS review rounds. The reviewer applies its own verdict
# (cmd_approve / cmd_request_changes), because leaving the PR unlabelled stalls
# the loop. Exit codes: 0 approved, 1 refusal, 4 blocked, 5 rounds exhausted.
ob_review_watch() {
    local repo=$1 pr=$2
    ob_need git gh omp aws jq
    ob_ensure_running

    local dir
    dir=$(ob_ensure_clone "$repo")
    ob_install_local_assets "$dir"

    local marker_dir marker rounds_max rounds
    marker_dir="$OB_CACHE_DIR/review"
    mkdir -p "$marker_dir"
    marker="$marker_dir/$(ob_repo_key "$repo")__$pr"
    # Sanitise the instance-side attempt cap the way ob-poll does: strip
    # non-digits, then default to 6.
    rounds_max=${OPENBUILDER_MAX_ATTEMPTS//[^0-9]/}
    rounds_max=${rounds_max:-6}
    rounds=0

    ob_info "watching $repo#$pr every ${OB_WATCH_INTERVAL}s, at most $rounds_max review rounds (Ctrl-C to stop)"

    local labels head_sha head ndjson rc seed
    while :; do
        labels=$(ob_pr_labels "$repo" "$pr")

        # First match wins, so blocked beats approved.
        if printf '%s\n' "$labels" | grep -qxF "$OB_LABEL_PREFIX:blocked"; then
            ob_warn "#$pr is labelled $OB_LABEL_PREFIX:blocked; last comment follows"
            ob_gh pr view "$pr" --repo "$repo" --json comments --jq '.comments | last | .body'
            printf '%s\n' "$OB_PROG: $repo#$pr is blocked; a human is required" >&2
            exit 4
        fi
        if printf '%s\n' "$labels" | grep -qxF "$OB_LABEL_PREFIX:approved"; then
            printf 'approved. land it with: %s land %s %s\n' "$OB_PROG" "$repo" "$pr"
            exit 0
        fi
        if printf '%s\n' "$labels" | grep -qxF "$OB_LABEL_PREFIX:changes-requested" ||
            printf '%s\n' "$labels" | grep -qxF "$OB_LABEL_PREFIX:in-progress"; then
            ob_info "#$pr is $OB_LABEL_PREFIX:in-progress/changes-requested; the instance owns it — waiting ${OB_WATCH_INTERVAL}s"
            sleep "$OB_WATCH_INTERVAL"
            continue
        fi
        if printf '%s\n' "$labels" | grep -qxF "$OB_LABEL_PREFIX:awaiting-review"; then
            head_sha=$(ob_gh pr view "$pr" --repo "$repo" --json headRefOid --jq '.headRefOid') || head_sha=''
            head=$(ob_gh pr view "$pr" --repo "$repo" --json headRefName --jq '.headRefName') || head=''
            if [[ -z $head_sha || -z $head ]]; then
                ob_warn "could not read the head sha of #$pr; retrying in ${OB_WATCH_INTERVAL}s"
                sleep "$OB_WATCH_INTERVAL"
                continue
            fi
            if [[ -f $marker && $(<"$marker") == "$head_sha" ]]; then
                ob_info "#$pr head $head_sha already reviewed — waiting ${OB_WATCH_INTERVAL}s"
                sleep "$OB_WATCH_INTERVAL"
                continue
            fi

            # Review this round, then loop back to read the verdict label.
            rounds=$((rounds + 1))
            if [[ $rounds -gt $rounds_max ]]; then
                printf '%s\n' "$OB_PROG: review rounds for $repo#$pr reached $rounds_max (OPENBUILDER_MAX_ATTEMPTS) without a verdict; a human is required" >&2
                exit 5
            fi

            git -C "$dir" fetch --prune --quiet origin
            if git -C "$dir" show-ref --verify --quiet "refs/remotes/origin/$head"; then
                ob_info "checking out $head for local inspection"
                git -C "$dir" checkout -B "$head" --track "origin/$head" --quiet
                git -C "$dir" reset --hard --quiet "origin/$head"
            else
                ob_warn "origin/$head not found locally; reviewing from the GitHub API only"
            fi

            ob_info "reviewing #$pr at $head_sha headlessly (round $rounds of $rounds_max)"

            seed=$(
                cat <<EOF
You are running as the openbuilder reviewer for $repo pull request #$pr
(head branch \`$head\`).

Start by reading \`pr://$pr\` — that gives you the description, the diff and
every existing comment. Then delegate to the \`reviewer\` agent (task tool,
agent: "reviewer") and follow the \`review-openbuilder-pr\` skill.

The pull request was produced by a small model from the story cards in
\`.openbuilder/backlog/\` on the plan branch, and its own notes are in
\`.openbuilder/backlog/<slug>/worklog.md\` on \`$head\`. Check the diff against
the acceptance criteria of every card, not against your own taste.

Finish by running exactly one of these two commands yourself, and nothing else:
  $OB_BIN_DIR/openbuilder approve $repo $pr
  $OB_BIN_DIR/openbuilder request-changes $repo $pr

Before request-changes, post line-anchored review comments a small model can act
on without guessing. You are running unattended: there is no human to hand the
verdict to, and leaving the pull request unlabelled stalls the loop.

Never merge, never push to $head, never push to a default branch.
EOF
            )

            ndjson="$marker_dir/$(ob_repo_key "$repo")__$pr.round-$(printf '%02d' "$rounds").ndjson"
            rc=0
            GH_REPO="$repo" omp --cwd "$dir" -p --no-pty --mode json --approval-mode yolo --auto-approve \
                --no-session --max-time "$OB_WATCH_MAX_TIME" --model "$OB_OPUS_MODEL" \
                --append-system-prompt "openbuilder reviewer session for $repo pull request #$pr. Read-only on the branch: comment and label, never merge, never push." \
                "$seed" >"$ndjson" 2>&1 || rc=$?
            ob_info "reviewer transcript: $ndjson"

            # The marker is written only after a run exits 0: a failed run must
            # be retried, not remembered as reviewed. The round counter has
            # already advanced, so a repeatedly failing run is bounded by the
            # cap instead of looping forever.
            if [[ $rc -eq 0 ]]; then
                printf '%s\n' "$head_sha" >"$marker"
                ob_info "recorded reviewed head $head_sha for #$pr"
            else
                ob_warn "reviewer run for #$pr exited $rc; marker not written, retrying next pass"
            fi
            sleep "$OB_WATCH_INTERVAL"
            continue
        fi

        ob_info "#$pr has no $OB_LABEL_PREFIX label yet — waiting ${OB_WATCH_INTERVAL}s"
        sleep "$OB_WATCH_INTERVAL"
    done
}

cmd_approve() {
    local usage="usage: $OB_PROG approve <owner/repo> <pr>"
    [[ $# -eq 2 ]] || ob_die "$usage"
    local repo=$1 pr=$2
    ob_validate_repo "$repo"
    ob_validate_pr "$pr"
    ob_need gh

    ob_ensure_labels "$repo"
    ob_pr_relabel "$repo" "$pr" "$OB_LABEL_PREFIX:approved" \
        "$OB_LABEL_PREFIX:awaiting-review,$OB_LABEL_PREFIX:changes-requested,$OB_LABEL_PREFIX:queued,$OB_LABEL_PREFIX:in-progress,$OB_LABEL_PREFIX:blocked"

    ob_gh pr comment "$pr" --repo "$repo" --body \
        "**openbuilder: approved.** Reviewed with \`$OB_OPUS_MODEL\`. The remote agent will stop touching this branch. A human may merge." >/dev/null

    ob_info "$repo#$pr labelled $OB_LABEL_PREFIX:approved — the instance will ignore it from now on"
    printf 'merge it with: gh pr merge %s --repo %s --squash\n' "$pr" "$repo"
}

cmd_request_changes() {
    local usage="usage: $OB_PROG request-changes <owner/repo> <pr>"
    [[ $# -eq 2 ]] || ob_die "$usage"
    local repo=$1 pr=$2
    ob_validate_repo "$repo"
    ob_validate_pr "$pr"
    ob_need gh aws jq

    ob_ensure_labels "$repo"
    ob_pr_relabel "$repo" "$pr" "$OB_LABEL_PREFIX:changes-requested" \
        "$OB_LABEL_PREFIX:awaiting-review,$OB_LABEL_PREFIX:approved,$OB_LABEL_PREFIX:queued"

    ob_gh pr comment "$pr" --repo "$repo" --body \
        "**openbuilder: changes requested.** See the review comments above. The remote agent will pick this up within 60s, start a fresh session against the existing worktree and push another round." >/dev/null

    # The instance only reacts while it is up.
    ob_ensure_running
    ob_info "$repo#$pr labelled $OB_LABEL_PREFIX:changes-requested — the instance responds within 60s"
}

# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------

# ob_status_unapproved <repo> <slug> — would rule 4b decline this plan branch?
# Prints exactly one token and never exits non-zero: '-' (rule 4b would let it
# through), 'yes' (rule 4b would decline it), '?' (an API call failed or a
# response did not parse, so the answer is unknown). Reports the same predicate
# rule 4b evaluates on the instance, because a rule-4b decline is deliberately
# silent (RFC §4.2-4.3) and this is the one visible surface for it. Three
# serial API calls per branch that has no pull request; no caching.
ob_status_unapproved() {
    local repo=$1 slug=$2
    local branch plan_md epic state_json listing verdict

    branch=$(ob_plan_branch "$slug")

    plan_md=$(ob_gh api "repos/$repo/contents/.openbuilder/backlog/$slug/plan.md?ref=$branch" \
        -H 'Accept: application/vnd.github.raw' 2>/dev/null) || {
        printf '?\n'
        return 0
    }
    epic=$(printf '%s\n' "$plan_md" | ob_epic_of_plan)
    [[ -n $plan_md && -n $epic && $epic =~ ^[a-z0-9][a-z0-9-]{1,48}$ ]] || {
        printf 'yes\n'
        return 0
    }

    state_json=$(ob_gh api "repos/$repo/contents/.openbuilder/epics/$epic/state.json?ref=$branch" \
        -H 'Accept: application/vnd.github.raw' 2>/dev/null) || {
        printf '?\n'
        return 0
    }
    jq empty <<<"$state_json" 2>/dev/null || {
        printf 'yes\n'
        return 0
    }

    listing=$(ob_gh api "repos/$repo/contents/.openbuilder/backlog/$slug?ref=$branch" 2>/dev/null) || {
        printf '?\n'
        return 0
    }

    # Rule 4b's predicate: stage == dispatched, an approval record for this
    # slug, and the recorded files map exactly equal to what the branch
    # carries — no extra card, no missing card, no changed sha. With `-e`,
    # exit 0 means true, 1 means false, anything else is a jq failure.
    verdict=0
    jq -e -n \
        --argjson listing "$listing" \
        --argjson state "$state_json" \
        --arg slug "$slug" \
        '([ $listing[] | select(.type == "file" and (.name == "plan.md" or (.name | test("^story-.*\\.md$")))) | {(.name): .sha} ] | add) as $disk
         | ($state | type) == "object"
           and $state.stage == "dispatched"
           and (($state.approvals.backlog[$slug] // {}) | type) == "object"
           and (($state.approvals.backlog[$slug].files // {}) | type) == "object"
           and $state.approvals.backlog[$slug].files == ($disk // {})' >/dev/null 2>&1 || verdict=$?
    case $verdict in
    0) printf -- '-\n' ;;
    1) printf 'yes\n' ;;
    *) printf '?\n' ;;
    esac
    return 0
}

cmd_status() {
    local usage="usage: $OB_PROG status [owner/repo]"
    [[ $# -le 1 ]] || ob_die "$usage"
    local repo
    repo=$(ob_repo_arg "${1:-}")
    ob_need gh jq

    local plan_refs work_refs prs rows
    plan_refs=$(ob_gh api "repos/$repo/git/matching-refs/heads/$OB_BRANCH_PREFIX/plan/" --paginate 2>/dev/null || printf '[]')
    work_refs=$(ob_gh api "repos/$repo/git/matching-refs/heads/$OB_BRANCH_PREFIX/work/" --paginate 2>/dev/null || printf '[]')
    prs=$(ob_gh pr list --repo "$repo" --state all --limit 200 \
        --json number,headRefName,labels,updatedAt,state 2>/dev/null || printf '[]')

    rows=$(jq -rn \
        --argjson plan "$plan_refs" \
        --argjson work "$work_refs" \
        --argjson prs "$prs" \
        --arg prefix "$OB_BRANCH_PREFIX" \
        '
        def slug_of($p): sub("^refs/heads/" + $prefix + "/" + $p + "/"; "");
        ($work | map(.ref | slug_of("work"))) as $workslugs
        | ($prs | map({ key: .headRefName, value: . }) | from_entries) as $byhead
        | $plan
        | map(.ref | slug_of("plan"))
        | sort
        | map(
            . as $s
            | ($byhead[$prefix + "/work/" + $s]) as $pr
            | [ $s,
                "yes",
                (if ($workslugs | index($s)) then "yes" else "-" end),
                (if $pr then ("#" + ($pr.number | tostring)) else "-" end),
                (if $pr then (($pr.labels | map(.name) | map(sub("^" + $prefix + ":"; "")) | join(","))
                             | if . == "" then "-" else . end) else "-" end),
                (if $pr then ($pr.updatedAt // "-") else "-" end)
              ]
            | @tsv
          )
        | .[]
        ')

    if [[ -z $rows ]]; then
        printf 'no %s/plan/* branches in %s\n' "$OB_BRANCH_PREFIX" "$repo"
        return 0
    fi

    printf '%s\n' "$repo"
    printf '%-26s %-5s %-5s %-6s %-7s %-40s %-22s\n' \
        SLUG PLAN WORK PR UNAPPR LABELS 'LAST ACTIVITY'
    printf '%-26s %-5s %-5s %-6s %-7s %-40s %-22s\n' \
        '--------------------------' '-----' '-----' '------' '-------' \
        '----------------------------------------' '----------------------'

    local slug plan work pr labels updated unappr
    while IFS=$'\t' read -r slug plan work pr labels updated; do
        [[ -n $slug ]] || continue
        # Rule 4b never reaches a slug that already has a pull request
        # (RFC §4.2), so only a PR-less branch needs the API predicate.
        unappr='-'
        if [[ $pr == '-' ]]; then
            unappr=$(ob_status_unapproved "$repo" "$slug")
        fi
        printf '%-26s %-5s %-5s %-6s %-7s %-40s %-22s\n' \
            "$slug" "$plan" "$work" "$pr" "$unappr" "$labels" "$updated"
    done <<<"$rows"
}

# ---------------------------------------------------------------------------
# logs
# ---------------------------------------------------------------------------

# A true `tail -f` needs a long-lived stream. SSM send-command is
# request/response: it runs a script to completion and hands back a bounded
# output blob, so there is no stream to follow. `-f` is therefore a bounded
# polling loop — each pass asks for the bytes appended since the previous pass,
# using a byte offset the instance reports back. For a real live terminal on the instance
# (interactive `tail -f`, journalctl, a shell) use `openbuilder shell`.
#
# The offset is safe because the instance treats this file as strictly append-only
# (ob_log in ob-common.sh and log() in bootstrap.sh both use `>>`, and nothing
# rotates it). A file that has shrunk is treated as replaced and re-read from 0.
#
# Long silences are expected: uneventful poll passes deliberately write nothing,
# because the idle-stop check measures this file's mtime and a chatty logger
# would keep the instance awake forever. Only real work appears here.
ob_logs_chunk_script() {
    local offset=$1
    cat <<EOF
f=$OB_REMOTE_LOG
off=$offset
if [ ! -f "\$f" ]; then
  printf '__OB_OFFSET__:%s\n' "\$off"
  echo "no log file yet at \$f" >&2
  exit 0
fi
size=\$(wc -c <"\$f" | tr -d '[:space:]')
if [ "\$off" -gt "\$size" ]; then off=0; fi
tmp=\$(mktemp)
tail -c "+\$((off + 1))" "\$f" 2>/dev/null | head -c $OB_LOG_CHUNK_BYTES >"\$tmp" || true
got=\$(wc -c <"\$tmp" | tr -d '[:space:]')
printf '__OB_OFFSET__:%s\n' "\$((off + got))"
cat "\$tmp"
rm -f "\$tmp"
EOF
}

ob_logs_tail_script() {
    local lines=$1
    cat <<EOF
f=$OB_REMOTE_LOG
if [ ! -f "\$f" ]; then
  echo "no log file yet at \$f" >&2
  exit 1
fi
size=\$(wc -c <"\$f" | tr -d '[:space:]')
printf '__OB_OFFSET__:%s\n' "\$size"
tail -n $lines "\$f"
EOF
}

cmd_logs() {
    local usage="usage: $OB_PROG logs [-f] [-n <lines>]"
    local follow=0 lines=200
    while [[ $# -gt 0 ]]; do
        case $1 in
        -f | --follow)
            follow=1
            shift
            ;;
        -n | --lines)
            [[ $# -ge 2 ]] || ob_die "$usage"
            [[ $2 =~ ^[0-9]+$ ]] || ob_die "$usage"
            lines=$2
            shift 2
            ;;
        -h | --help)
            printf '%s\n' "$usage"
            return 0
            ;;
        *)
            ob_die "$usage"
            ;;
        esac
    done
    ob_need aws jq

    local out rc=0 offset=0
    out=$(ob_ssm_exec "$(ob_logs_tail_script "$lines")") || rc=$?
    offset=$(ob_logs_split_offset "$out")
    ob_logs_print_body "$out"
    if [[ $follow -eq 0 ]]; then
        return "$rc"
    fi

    ob_info "following $OB_REMOTE_LOG over SSM every ${OB_LOG_FOLLOW_INTERVAL}s (Ctrl-C to stop)"
    ob_info "silence is normal — idle poll passes log nothing; for every poll decision run '$OB_PROG shell' then 'journalctl -fu openbuilder-poll.service'"
    while :; do
        sleep "$OB_LOG_FOLLOW_INTERVAL"
        rc=0
        out=$(ob_ssm_exec "$(ob_logs_chunk_script "$offset")") || rc=$?
        if [[ $rc -ne 0 ]]; then
            ob_warn "log poll failed (exit $rc); retrying"
            continue
        fi
        offset=$(ob_logs_split_offset "$out")
        ob_logs_print_body "$out"
    done
}

ob_logs_split_offset() {
    local first
    first=$(printf '%s\n' "$1" | sed -n '1s/^__OB_OFFSET__://p' | tr -d '[:space:]')
    [[ $first =~ ^[0-9]+$ ]] || first=0
    printf '%s\n' "$first"
}

ob_logs_print_body() {
    printf '%s' "$1" | awk 'NR == 1 && /^__OB_OFFSET__:/ { next } { print }'
}

# ---------------------------------------------------------------------------
# shell / doctor
# ---------------------------------------------------------------------------

cmd_shell() {
    local usage="usage: $OB_PROG shell"
    [[ $# -eq 0 ]] || ob_die "$usage"
    ob_need aws session-manager-plugin
    ob_ensure_running
    local region instance
    region=$(ob_region)
    instance=$(ob_instance_id)
    ob_info "opening an SSM session on $instance ($region)"
    printf 'tip: sudo -iu %s, then tail -f %s\n' "$OB_REMOTE_USER" "$OB_REMOTE_LOG" >&2
    # `exec` needs a real binary, so the wrapper's env scoping is inlined here
    # rather than calling the ob_aws function.
    if [[ -n ${OPENBUILDER_AWS_PROFILE:-} ]]; then
        exec env AWS_PROFILE="$OPENBUILDER_AWS_PROFILE" AWS_REGION="$region" \
            AWS_DEFAULT_REGION="$region" aws ssm start-session --target "$instance"
    fi
    exec env AWS_REGION="$region" AWS_DEFAULT_REGION="$region" \
        aws ssm start-session --target "$instance"
}

cmd_doctor() {
    local usage="usage: $OB_PROG doctor"
    [[ $# -eq 0 ]] || ob_die "$usage"
    ob_need aws jq
    ob_ensure_running

    local out rc=0
    out=$(ob_ssm_exec "$(ob_remote_as_user "$OB_REMOTE_HOME/bin/ob-doctor")" 900) || rc=$?
    [[ -n $out ]] && printf '%s' "$out"
    if [[ $rc -eq 0 ]]; then
        ob_info "ob-doctor passed"
    else
        ob_warn "ob-doctor failed with exit code $rc"
    fi
    return "$rc"
}

# ---------------------------------------------------------------------------
# start / stop
# ---------------------------------------------------------------------------

cmd_start() {
    local usage="usage: $OB_PROG start"
    [[ $# -eq 0 ]] || ob_die "$usage"
    ob_need aws
    ob_ensure_running
    printf 'state: %s\n' "$(ob_instance_state)"
}

cmd_stop() {
    local usage="usage: $OB_PROG stop"
    [[ $# -eq 0 ]] || ob_die "$usage"
    ob_need aws
    local region instance state
    region=$(ob_region)
    instance=$(ob_instance_id)
    state=$(ob_instance_state)
    case $state in
    stopped)
        ob_info "instance $instance already stopped"
        ;;
    stopping)
        ob_info "instance $instance already stopping; waiting"
        ob_aws ec2 wait instance-stopped --region "$region" --instance-ids "$instance"
        ;;
    *)
        ob_info "stopping instance $instance"
        ob_aws ec2 stop-instances --region "$region" --instance-ids "$instance" >/dev/null
        ob_aws ec2 wait instance-stopped --region "$region" --instance-ids "$instance"
        ;;
    esac
    printf 'state: %s\n' "$(ob_instance_state)"
    printf 'note: the instance also stops itself after OPENBUILDER_IDLE_STOP_MINUTES of idleness.\n'
}

# ---------------------------------------------------------------------------
# cost
# ---------------------------------------------------------------------------

# The instance keeps one NDJSON per attempt at
#   state/<owner>__<repo>__<slug>/rounds/<NNN>/run.ndjson
# so walk with find and fold the rounds back onto their slug. The flat
# state/<key>/run.ndjson layout is handled too, so this keeps working if a job
# writes its transcript one level up.
ob_cost_script() {
    cat <<EOF
find $OB_REMOTE_HOME/state -type f -name run.ndjson 2>/dev/null | sort | while read -r f; do
  d=\$(dirname "\$f")
  case "\$d" in
    */rounds/*) key=\$(basename "\$(dirname "\$(dirname "\$d")")") ;;
    *) key=\$(basename "\$d") ;;
  esac
  c=\$(jq -s 'map(select(.type=="message_end")|.message.usage.cost.total//0)|add//0' "\$f" 2>/dev/null || echo 0)
  printf '%s\t%s\n' "\$key" "\$c"
done
EOF
}

cmd_cost() {
    local usage="usage: $OB_PROG cost"
    [[ $# -eq 0 ]] || ob_die "$usage"
    ob_need aws jq awk
    ob_ensure_running

    local out rc=0
    out=$(ob_ssm_exec "$(ob_cost_script)") || rc=$?
    if [[ $rc -ne 0 ]]; then
        ob_die "could not read model spend from the instance (exit $rc)"
    fi
    if [[ -z ${out//[[:space:]]/} ]]; then
        printf 'no run.ndjson files under %s/state yet — nothing has run.\n' "$OB_REMOTE_HOME"
        return 0
    fi

    printf 'model spend on %s (from %s/state/**/run.ndjson)\n\n' \
        "$(ob_instance_id)" "$OB_REMOTE_HOME"
    printf '%-48s %7s %12s\n' 'JOB (owner__repo__slug)' 'ROUNDS' 'USD'
    printf '%-48s %7s %12s\n' \
        '------------------------------------------------' '-------' '------------'
    # One input line per round; fold them onto the slug, first-seen order.
    printf '%s' "$out" | awk -F'\t' '
        NF < 2 { next }
        {
            if (!($1 in seen)) { seen[$1] = 1; order[++n] = $1 }
            sum[$1] += $2 + 0
            rounds[$1] += 1
            total += $2 + 0
            files += 1
        }
        END {
            for (i = 1; i <= n; i++) {
                k = order[i]
                printf "%-48s %7d %12.4f\n", k, rounds[k], sum[k]
            }
            printf "%-48s %7s %12s\n", "------------------------------------------------", "-------", "------------"
            printf "%-48s %7d %12.4f\n", "TOTAL", files + 0, total + 0
        }'
    printf '\nEC2/EBS cost is not included here — see docs/cost.md and the AWS budget alarm.\n'
}

# ---------------------------------------------------------------------------
# dispatch table
# ---------------------------------------------------------------------------

main() {
    ob_load_local_config

    local sub=${1:-help}
    [[ $# -gt 0 ]] && shift

    case $sub in
    plan) cmd_plan "$@" ;;
    dispatch) cmd_dispatch "$@" ;;
    review) cmd_review "$@" ;;
    approve) cmd_approve "$@" ;;
    request-changes) cmd_request_changes "$@" ;;
    status) cmd_status "$@" ;;
    logs) cmd_logs "$@" ;;
    shell) cmd_shell "$@" ;;
    doctor) cmd_doctor "$@" ;;
    start) cmd_start "$@" ;;
    stop) cmd_stop "$@" ;;
    cost) cmd_cost "$@" ;;
    help | -h | --help) cmd_help ;;
    *)
        printf '%s: unknown command: %s\n\n' "$OB_PROG" "$sub" >&2
        ob_command_table >&2
        exit 2
        ;;
    esac
}

main "$@"
