#!/usr/bin/env bash
# ob-gate — the only writer of .openbuilder/epics/<epic>/state.json.
#
# state.json records which artifact content a human approved. An approval
# authored by a model is worthless, because the whole value of the record is
# that it is mechanical: exactly one deterministic script computes the git
# blob shas and writes the file. This script does that — init, stage, record,
# verify, show — with every write done by jq assignment onto the parsed
# document (so unknown keys such as `notes` survive), atomically, and with
# every state mutation committed and pushed.
set -euo pipefail
IFS=$'\n\t'

OB_PROG="ob-gate"
REPO_ROOT="$(git rev-parse --show-toplevel)"
TMP_STATE=""
STAGES=(intake prd rfc backlog dispatched landed)

usage() {
  cat <<EOF
usage: ob-gate init   <epic> --repo <owner/repo>
       ob-gate stage  <epic> <stage>
       ob-gate record <epic> prd|rfc
       ob-gate record <epic> backlog <slug>
       ob-gate verify <epic> [prd|rfc|backlog [<slug>]|--all]
       ob-gate show   <epic>
       ob-gate --help

subcommands:
  init    write .openbuilder/epics/<epic>/state.json at stage intake
  stage   move the stage pointer; <stage> is one of
          intake, prd, rfc, backlog, dispatched, landed
  record  record human approval of an artifact: compute its git blob sha,
          write state.json, advance the stage, commit with an
          Approves-<stage>: <sha> trailer, and push
  verify  re-check recorded approvals against the bytes on disk;
          the default target is --all
  show    print the recorded state, human-readable

exit codes:
  0  success; for verify, every checked approval is intact
  1  operational refusal (artifact not committed, push failed, no state file)
  2  usage error (unknown subcommand, bad argument, missing value)
  3  verify: an approval is void — the artifact changed since it was recorded
  4  verify: an approval is absent — nothing was recorded for that target
EOF
}

cleanup() {
  if [[ -n "$TMP_STATE" ]]; then
    rm -f "$TMP_STATE"
  fi
  return 0
}
trap cleanup EXIT

die() {
  local msg="$1" code="${2:-1}"
  printf '%s: %s\n' "$OB_PROG" "$msg" >&2
  exit "$code"
}

need_jq() {
  command -v jq >/dev/null 2>&1 ||
    die "jq is required and was not found on PATH" 1
}

require_epic() {
  local name="$1"
  [[ "$name" =~ ^[a-z0-9][a-z0-9-]{1,48}$ ]] ||
    die "invalid epic name '$name' (expected ^[a-z0-9][a-z0-9-]{1,48}\$)" 2
}

require_repo_arg() {
  local arg="$1"
  [[ "$arg" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] ||
    die "not a valid <owner>/<repo>: $arg" 2
}

epic_rel() {
  local epic="$1"
  printf '.openbuilder/epics/%s' "$epic"
}

state_rel() {
  local epic="$1"
  printf '%s/state.json' "$(epic_rel "$epic")"
}

state_path() {
  local epic="$1"
  printf '%s/%s' "$REPO_ROOT" "$(state_rel "$epic")"
}

artifact_rel() {
  local epic="$1" t="$2"
  printf '.openbuilder/epics/%s/%s.md' "$epic" "$t"
}

backlog_rel() {
  local slug="$1"
  printf '.openbuilder/backlog/%s' "$slug"
}

require_committed() {
  local rel="$1" fix="$2" line base
  if ! git -C "$REPO_ROOT" diff --quiet HEAD -- "$rel"; then
    die "$rel has uncommitted changes; commit them first, then re-run: $fix" 1
  fi
  # An untracked plan.md or story-*.md means the recorded sha would describe
  # bytes nobody read; any other untracked name is ignored.
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    base="${line##*/}"
    case "$base" in
      plan.md | story-*.md)
        die "$line is not committed at HEAD; commit it first, then re-run: $fix" 1
        ;;
      *) ;;
    esac
  done < <(git -C "$REPO_ROOT" ls-files --others --exclude-standard -- "$rel")
}

read_state() {
  local epic="$1" p
  p="$(state_path "$epic")"
  [[ -r "$p" ]] ||
    die "no epic state at $(state_rel "$epic"); run: ob-gate init <epic> --repo <owner/repo>" 1
  cat "$p"
}

write_state() {
  local epic="$1" dir target tmp
  dir="$(dirname "$(state_path "$epic")")"
  target="$(state_path "$epic")"
  tmp="$(mktemp "${dir}/.ob-gate.tmp.XXXXXX")"
  TMP_STATE="$tmp"
  cat >"$TMP_STATE"
  # This function is the last element of a pipefail pipeline; when a middle
  # stage (jq) fails, stdin is empty or truncated and the failure is only
  # reported after we have run. Do not mv garbage over the one record this
  # script exists to protect: refuse, and remove the temp file here — in a
  # subshell, TMP_STATE never reaches the parent's EXIT trap.
  if [[ ! -s "$TMP_STATE" ]] ||
     ! jq -e 'type == "object" and has("epic") and has("stage") and has("approvals")' \
       "$TMP_STATE" >/dev/null 2>&1; then
    rm -f "$TMP_STATE"
    TMP_STATE=""
    die "refusing to overwrite state.json: staged document at ${tmp} is empty or not a valid state object (removed); state.json was left untouched" 1
  fi
  mv "$TMP_STATE" "$target"
  TMP_STATE=""
}

commit_state() {
  local epic="$1" subject="$2" trailer="${3:-}" rel tracked
  rel="$(state_rel "$epic")"
  tracked="$(git -C "$REPO_ROOT" rev-parse --verify --quiet "HEAD:${rel}" 2>/dev/null || true)"
  if [[ -n "$tracked" ]] && git -C "$REPO_ROOT" diff --quiet HEAD -- "$rel"; then
    printf '%s: state.json already up to date; nothing committed\n' "$OB_PROG"
    return 0
  fi
  # A pathspec commit cannot see an untracked file; stage only this one
  # path, leaving every other staged or unstaged change untouched.
  git -C "$REPO_ROOT" ls-files --error-unmatch -- "$rel" >/dev/null 2>&1 ||
    git -C "$REPO_ROOT" add -- "$rel"
  if [[ -n "$trailer" ]]; then
    git -C "$REPO_ROOT" commit --quiet -m "$subject" -m "$trailer" -- "$rel"
  else
    git -C "$REPO_ROOT" commit --quiet -m "$subject" -- "$rel"
  fi
  local branch short
  branch="$(git -C "$REPO_ROOT" rev-parse --abbrev-ref HEAD)"
  if ! git -C "$REPO_ROOT" push --quiet origin "HEAD:refs/heads/${branch}"; then
    short="$(git -C "$REPO_ROOT" rev-parse --short HEAD)"
    die "push to origin failed; state.json is committed locally as ${short} — re-run: git push origin HEAD:refs/heads/${branch}" 1
  fi
  printf 'pushed %s to origin\n' "$branch"
}

cmd_init() {
  local epic="${1:-}" repo="" arg
  [[ -n "$epic" ]] || die "missing <epic>" 2
  require_epic "$epic"
  shift
  while (($# > 0)); do
    arg="$1"
    if [[ "$arg" == "--repo" ]]; then
      shift
      (($# > 0)) && [[ -n "$1" ]] || die "missing value for --repo" 2
      repo="$1"
    else
      die "unknown argument: '$arg' (accepted: --repo)" 2
    fi
    shift
  done
  [[ -n "$repo" ]] || die "missing required --repo <owner/repo>" 2
  require_repo_arg "$repo"
  local rel opened doc
  rel="$(state_rel "$epic")"
  [[ ! -e "$(state_path "$epic")" ]] ||
    die "state.json already exists at ${rel}; use 'ob-gate stage' or 'ob-gate record'" 2
  mkdir -p "$(dirname "$(state_path "$epic")")"
  opened="$(date -u +%Y-%m-%d)"
  doc="$(jq -n --arg epic "$epic" --arg repo "$repo" --arg opened "$opened" \
    '{epic: $epic, repo: $repo, stage: "intake", opened: $opened, slugs: [], approvals: {prd: {}, rfc: {}, backlog: {}}}')"
  printf '%s\n' "$doc" | write_state "$epic"
  printf 'opened epic %s at stage intake (%s)\n' "$epic" "$rel"
  commit_state "$epic" "openbuilder(gate): open epic $epic"
}

cmd_stage() {
  local epic="${1:-}" stage="${2:-}" s ok=0
  [[ -n "$epic" ]] || die "missing <epic>" 2
  require_epic "$epic"
  for s in "${STAGES[@]}"; do
    [[ "$s" == "$stage" ]] && ok=1
  done
  ((ok == 1)) ||
    die "unknown stage: '$stage' (accepted: intake, prd, rfc, backlog, dispatched, landed)" 2
  read_state "$epic" | jq --arg s "$stage" '.stage = $s' | write_state "$epic"
  printf '%s stage -> %s\n' "$epic" "$stage"
  commit_state "$epic" "openbuilder(gate): stage $epic -> $stage"
}

record_artifact() {
  local epic="$1" stage="$2" rel blob at next doc
  doc="$(read_state "$epic")"
  rel="$(artifact_rel "$epic" "$stage")"
  [[ -f "${REPO_ROOT}/${rel}" ]] || die "no such artifact: $rel" 1
  blob="$(git -C "$REPO_ROOT" rev-parse --verify --quiet "HEAD:${rel}" || true)"
  [[ -n "$blob" ]] ||
    die "$rel is not committed at HEAD; commit it first, then re-run: ob-gate record $epic $stage" 1
  require_committed "$rel" "ob-gate record $epic $stage"
  at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  if [[ "$stage" == "prd" ]]; then
    next="rfc"
  else
    next="backlog"
  fi
  printf '%s' "$doc" | jq --arg at "$at" --arg blob "$blob" --arg next "$next" --arg stage "$stage" \
    '.approvals[$stage] = {at: $at, blob: $blob} | .stage = $next' | write_state "$epic"
  printf 'recorded %s approval for %s: %s\n' "$stage" "$epic" "$blob"
  printf '%s stage -> %s\n' "$epic" "$next"
  commit_state "$epic" "openbuilder(gate): approve $stage for $epic" "Approves-$stage: $blob"
}

record_backlog() {
  local epic="${1:-}" slug="${2:-}" doc dir
  [[ -n "$slug" ]] || die "missing <slug> for 'record backlog'" 2
  [[ "$slug" =~ ^[a-z0-9][a-z0-9-]{1,48}$ ]] ||
    die "invalid slug '$slug' (expected ^[a-z0-9][a-z0-9-]{1,48}\$)" 2
  doc="$(read_state "$epic")"
  dir="$(backlog_rel "$slug")"
  require_committed "$dir" "ob-gate record $epic backlog $slug"
  # Enumerate in ls-tree order: plan.md before every story-*.md.
  local -a kept=()
  local name base
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    base="${name##*/}"
    case "$base" in
      plan.md | story-*.md) kept+=("$base") ;;
      *) ;; # worklog.md and any other name never enter the record
    esac
  done < <(git -C "$REPO_ROOT" ls-tree --name-only HEAD -- "${dir}/")
  local has_plan=0 has_story=0 k
  for k in "${kept[@]}"; do
    [[ "$k" == "plan.md" ]] && has_plan=1
    [[ "$k" == story-*.md ]] && has_story=1
  done
  ((has_plan == 1)) || die "${dir}/plan.md is not committed at HEAD" 1
  ((has_story == 1)) || die "${dir}/ has no story-*.md; a backlog with no cards cannot be approved" 1
  local lines="" blob
  for k in "${kept[@]}"; do
    blob="$(git -C "$REPO_ROOT" rev-parse --verify --quiet "HEAD:${dir}/${k}" || true)"
    lines+="${k}"$'\t'"${blob}"$'\n'
  done
  local files at tree n
  files="$(printf '%s' "$lines" | jq -R -s 'split("\n") | map(select(length > 0) | split("\t")) | map({(.[0]): .[1]}) | add')"
  at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf '%s' "$doc" | jq --arg slug "$slug" --arg at "$at" --argjson files "$files" \
    '.approvals.backlog[$slug] = {at: $at, files: $files} | (if (.slugs | index($slug)) then . else .slugs += [$slug] end)' |
    write_state "$epic"
  n="${#kept[@]}"
  tree="$(git -C "$REPO_ROOT" rev-parse --verify --quiet "HEAD:${dir}" || true)"
  printf 'recorded backlog approval for %s/%s: %s file(s)\n' "$epic" "$slug" "$n"
  commit_state "$epic" "openbuilder(gate): approve backlog $slug for $epic" "Approves-backlog: $tree"
}

cmd_record() {
  local epic="${1:-}" target="${2:-}" slug="${3:-}"
  [[ -n "$epic" ]] || die "missing <epic>" 2
  require_epic "$epic"
  case "$target" in
    prd | rfc)
      record_artifact "$epic" "$target"
      ;;
    backlog)
      record_backlog "$epic" "$slug"
      ;;
    *)
      die "unknown record target: '$target' (accepted: prd, rfc, backlog)" 2
      ;;
  esac
}

cmd_show() {
  local epic="${1:-}" doc
  [[ -n "$epic" ]] || die "missing <epic>" 2
  require_epic "$epic"
  doc="$(read_state "$epic")"
  printf '%-8s %s\n' "epic" "$(printf '%s' "$doc" | jq -r '.epic')"
  printf '%-8s %s\n' "repo" "$(printf '%s' "$doc" | jq -r '.repo')"
  printf '%-8s %s\n' "stage" "$(printf '%s' "$doc" | jq -r '.stage')"
  printf '%-8s %s\n' "opened" "$(printf '%s' "$doc" | jq -r '.opened')"
  printf '%-8s %s\n' "slugs" "$(printf '%s' "$doc" | jq -r 'if (.slugs | length) == 0 then "none" else (.slugs | join(", ")) end')"
  printf '%-8s %s\n' "prd" "$(printf '%s' "$doc" | jq -r 'if (.approvals.prd.blob // "") == "" then "not approved" else "approved " + (.approvals.prd.at // "") + " " + .approvals.prd.blob end')"
  printf '%-8s %s\n' "rfc" "$(printf '%s' "$doc" | jq -r 'if (.approvals.rfc.blob // "") == "" then "not approved" else "approved " + (.approvals.rfc.at // "") + " " + .approvals.rfc.blob end')"
  if [[ "$(printf '%s' "$doc" | jq -r '.approvals.backlog | length')" == "0" ]]; then
    printf '%-8s %s\n' "backlog" "none recorded"
  else
    local slug line
    while IFS= read -r slug; do
      [[ -n "$slug" ]] || continue
      line="$(printf '%s' "$doc" | jq -r --arg slug "$slug" \
        '(.approvals.backlog[$slug].at // "") as $at | (.approvals.backlog[$slug].files | length) as $n | "\($slug) approved \($at) \($n) file(s)"')"
      printf '%-8s %s\n' "backlog" "$line"
    done < <(printf '%s' "$doc" | jq -r '.approvals.backlog | keys_unsorted[]')
  fi
}

verify_artifact() {
  local epic="$1" t="$2" doc="$3" recorded rel abs blob
  recorded="$(printf '%s' "$doc" | jq -r --arg t "$t" '.approvals[$t].blob // ""')"
  if [[ -z "$recorded" || "$recorded" == "null" ]]; then
    printf '%s: %s ABSENT — no approval recorded\n' "$OB_PROG" "$t"
    printf '%s: fix: ob-gate record %s %s\n' "$OB_PROG" "$epic" "$t"
    absent_seen=1
    return 0
  fi
  rel="$(artifact_rel "$epic" "$t")"
  abs="${REPO_ROOT}/${rel}"
  if [[ ! -f "$abs" ]]; then
    printf '%s: %s VOID — %s.md missing since approval\n' "$OB_PROG" "$t" "$t"
    printf '%s: fix: ob-gate record %s %s\n' "$OB_PROG" "$epic" "$t"
    void_seen=1
    return 0
  fi
  blob="$(git hash-object -- "$abs")"
  if [[ "$blob" != "$recorded" ]]; then
    printf '%s: %s VOID — %s.md changed since approval\n' "$OB_PROG" "$t" "$t"
    printf '%s: fix: ob-gate record %s %s\n' "$OB_PROG" "$epic" "$t"
    void_seen=1
    return 0
  fi
  printf '%s: %s intact %s\n' "$OB_PROG" "$t" "$recorded"
}

verify_backlog_slug() {
  local epic="$1" doc="$2" slug="$3" files n rel abs
  files="$(printf '%s' "$doc" | jq -c --arg slug "$slug" '.approvals.backlog[$slug].files // {}')"
  n="$(printf '%s' "$files" | jq 'length')"
  if [[ "$files" == "{}" || "$n" == "0" ]]; then
    printf '%s: backlog/%s ABSENT — no approval recorded\n' "$OB_PROG" "$slug"
    printf '%s: fix: ob-gate record %s backlog %s\n' "$OB_PROG" "$epic" "$slug"
    absent_seen=1
    return 0
  fi
  rel="$(backlog_rel "$slug")"
  abs="${REPO_ROOT}/${rel}"
  local -a mapped=()
  local key
  while IFS= read -r key; do
    [[ -n "$key" ]] || continue
    mapped+=("$key")
  done < <(printf '%s' "$files" | jq -r 'keys[]')
  local void=0 blob expected
  for key in "${mapped[@]}"; do
    if [[ ! -f "${abs}/${key}" ]]; then
      printf '%s: backlog/%s VOID — %s missing since approval\n' "$OB_PROG" "$slug" "$key"
      void=1
    else
      blob="$(git hash-object -- "${abs}/${key}")"
      expected="$(printf '%s' "$files" | jq -r --arg key "$key" '.[$key]')"
      if [[ "$blob" != "$expected" ]]; then
        printf '%s: backlog/%s VOID — %s changed since approval\n' "$OB_PROG" "$slug" "$key"
        void=1
      fi
    fi
  done
  # Any plan.md or story-*.md on disk that the record does not cover voids
  # the approval, exactly as rule 4b enforces on the plan branch.
  local name base
  for name in "${abs}"/*; do
    [[ -f "$name" ]] || continue
    base="${name##*/}"
    case "$base" in
      plan.md | story-*.md) ;;
      *) continue ;;
    esac
    if ! printf '%s\n' "${mapped[@]}" | grep -qx -- "$base"; then
      printf '%s: backlog/%s VOID — %s is not covered by the approval\n' "$OB_PROG" "$slug" "$base"
      void=1
    fi
  done
  if ((void == 1)); then
    printf '%s: fix: ob-gate record %s backlog %s\n' "$OB_PROG" "$epic" "$slug"
    void_seen=1
    return 0
  fi
  printf '%s: backlog/%s intact %s file(s)\n' "$OB_PROG" "$slug" "$n"
}

verify_backlog() {
  local epic="$1" doc="$2" slug="${3:-}" total s
  if [[ -n "$slug" ]]; then
    verify_backlog_slug "$epic" "$doc" "$slug"
    return 0
  fi
  total="$(printf '%s' "$doc" | jq -r '.approvals.backlog | length')"
  if [[ "$total" == "0" ]]; then
    printf '%s: backlog ABSENT — no approval recorded\n' "$OB_PROG"
    absent_seen=1
    return 0
  fi
  while IFS= read -r s; do
    [[ -n "$s" ]] || continue
    verify_backlog_slug "$epic" "$doc" "$s"
  done < <(printf '%s' "$doc" | jq -r '.approvals.backlog | keys_unsorted[]')
}

cmd_verify() {
  local epic="${1:-}" target="${2:---all}" p doc
  [[ -n "$epic" ]] || die "missing <epic>" 2
  require_epic "$epic"
  case "$target" in
    --all | prd | rfc | backlog) ;;
    *)
      die "unknown verify target: '$target' (accepted: prd, rfc, backlog, --all)" 2
      ;;
  esac
  # Absence is reported as 4, not 1, so verify must not use read_state.
  p="$(state_path "$epic")"
  if [[ ! -r "$p" ]]; then
    printf '%s: no approval recorded for %s: %s does not exist\n' "$OB_PROG" "$epic" "$(state_rel "$epic")"
    exit 4
  fi
  doc="$(cat "$p")"
  void_seen=0
  absent_seen=0
  case "$target" in
    --all)
      verify_artifact "$epic" "prd" "$doc"
      verify_artifact "$epic" "rfc" "$doc"
      verify_backlog "$epic" "$doc"
      ;;
    prd | rfc)
      verify_artifact "$epic" "$target" "$doc"
      ;;
    backlog)
      verify_backlog "$epic" "$doc" "${3:-}"
      ;;
  esac
  # Void outranks absent: a voided approval is what a human must see first.
  if ((void_seen == 1)); then
    exit 3
  fi
  if ((absent_seen == 1)); then
    exit 4
  fi
  exit 0
}

main() {
  local sub="${1:-}"
  need_jq
  if [[ -z "$sub" ]]; then
    usage >&2
    exit 2
  fi
  case "$sub" in
    -h | --help)
      usage
      exit 0
      ;;
    init)
      shift
      cmd_init "$@"
      ;;
    stage)
      shift
      cmd_stage "$@"
      ;;
    record)
      shift
      cmd_record "$@"
      ;;
    verify)
      shift
      cmd_verify "$@"
      ;;
    show)
      shift
      cmd_show "$@"
      ;;
    *)
      die "unknown subcommand: '$sub' (accepted: init, stage, record, verify, show)" 2
      ;;
  esac
}

main "$@"