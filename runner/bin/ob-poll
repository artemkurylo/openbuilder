#!/usr/bin/env bash
# ob-poll — one pass of the §6 state machine over every configured repo.
# Single responsibility: decide, for each plan branch, which single action is due
# and dispatch it. All the work itself lives in ob-implement / ob-respond.
#
# Deliberate logging rule: an uneventful pass writes NOTHING to
# $OPENBUILDER_HOME/log/openbuilder.log — decisions go to stdout (the journal)
# only. ob-idle-stop treats the log's mtime as "when work last happened", so a
# chatty poll pass would keep the instance awake forever. Rule 4b reads the plan
# branch's backlog approval and declines with action=skip when it is missing, so
# a decline costs no attempt, no label, no comment and no log line.
set -euo pipefail
IFS=$'\n\t'

# shellcheck disable=SC2034  # consumed by ob-common.sh's ob_log prefix after sourcing
OB_PROG="ob-poll"
OB_SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./ob-common.sh
source "${OB_SELF_DIR}/ob-common.sh"

DRY_RUN=0
# Count of slugs that need real work this pass (rules 5 and 6). ob-idle-stop
# parses the trailing ACTIONABLE= line.
ACTIONABLE=0
MAX_ATTEMPTS=6

usage() {
  cat <<'EOF'
Usage: ob-poll [--dry-run]

Runs one pass of the OpenBuilder state machine (spec §6).

  --dry-run   Print the decision for every slug and exit 0 without taking any
              action, creating any label, or writing any state. Used by
              ob-idle-stop to decide whether the instance may power itself off.

Output: one `DECISION ...` line per slug, then a final `ACTIONABLE=<n>` line.
EOF
}

# decision <repo> <slug> <rule> <action> <reason>
decision() {
  printf 'DECISION repo=%s slug=%s rule=%s action=%s reason=%s\n' \
    "$1" "$2" "$3" "$4" "$5"
}

# list_plan_refs <owner/repo> — every refs/heads/<prefix>/plan/* ref.
list_plan_refs() {
  local repo="$1"
  ob_gh api \
    "repos/${repo}/git/matching-refs/heads/${OPENBUILDER_BRANCH_PREFIX}/plan/" \
    --jq '.[].ref' 2>/dev/null || true
}

# safe_field <value> <max-len> — scrub a value that came from branch content so
# it cannot break the key=value shape of a DECISION line. Keeps only
# [A-Za-z0-9._-], truncates to <max-len>, prints `-` when empty. Always returns 0.
safe_field() {
  local value="$1" max="$2" out
  out="${value//[^A-Za-z0-9._-]/}"
  out="${out:0:max}"
  if [[ -z "$out" ]]; then
    printf '%s' '-'
  else
    printf '%s' "$out"
  fi
  return 0
}

# gh_contents_raw <owner/repo> <ref> <path> — the body of a file at a ref, on
# stdout; the `raw` Accept header returns the bytes directly. Empty output means
# unreadable (404, 502, rate limit). `gh api` prints a non-2xx response body to
# stdout and fails non-zero, so the exit status is what distinguishes a missing
# file from a real body; stderr is discarded.
gh_contents_raw() {
  local repo="$1" ref="$2" path="$3" out rc=0
  out="$(ob_gh api -H "Accept: application/vnd.github.raw" \
    "repos/${repo}/contents/${path}?ref=${ref}" 2>/dev/null)" || rc=$?
  if ((rc != 0)); then
    return 0
  fi
  printf '%s' "$out"
}

# backlog_listing <owner/repo> <ref> <dir> — one `name<TAB>sha` line per file
# entry of a directory listing at a ref. An entry's sha is the git blob sha, so
# the file-set check needs no card content. Empty output means unreadable.
backlog_listing() {
  local repo="$1" ref="$2" dir="$3" out rc=0
  out="$(ob_gh api "repos/${repo}/contents/${dir}?ref=${ref}" \
    --jq '.[] | select(.type == "file") | "\(.name)\t\(.sha)"' 2>/dev/null)" || rc=$?
  if ((rc != 0)); then
    return 0
  fi
  printf '%s\n' "$out"
}

# backlog_decline_reason <owner/repo> <slug> — rule 4b. Reads the plan branch's
# backlog approval from GitHub and prints the reason string (no trailing newline)
# when the backlog is not approved; prints nothing when it is. Always returns 0:
# a non-zero return would abort the pass under `set -e`, and a decline has no
# side effect, so a read failure is reported as the same reason as an absent file.
backlog_decline_reason() {
  local repo="$1" slug="$2"
  local ref dir body epic stage recorded_entries
  local -A recorded=() listed=()
  local -a listing=() all_names=() names=()
  local name sha n rsha lsha

  ref="${OPENBUILDER_BRANCH_PREFIX}/plan/${slug}"
  dir=".openbuilder/backlog/${slug}"

  body="$(gh_contents_raw "$repo" "$ref" "${dir}/plan.md")" || true
  epic="$(printf '%s' "$body" | awk '/^- epic:/ {print $3; exit}')" || true
  if [[ -z "$body" || -z "$epic" || ! "$epic" =~ ^[a-z0-9][a-z0-9-]{1,48}$ ]]; then
    printf 'backlog-unapproved:no-epic-line'
    return 0
  fi

  body="$(gh_contents_raw "$repo" "$ref" ".openbuilder/epics/${epic}/state.json")" || true
  if [[ -z "$body" ]] || ! printf '%s' "$body" | jq -e . >/dev/null 2>&1; then
    printf 'backlog-unapproved:no-state'
    return 0
  fi

  stage="$(printf '%s' "$body" | jq -r '.stage // empty' 2>/dev/null)" || true
  if [[ "$stage" != "dispatched" ]]; then
    printf 'backlog-unapproved:stage=%s' "$(safe_field "$stage" 32)"
    return 0
  fi

  recorded_entries="$(printf '%s' "$body" | jq -r --arg s "$slug" \
    '.approvals.backlog[$s].files // {} | to_entries[] | "\(.key)\t\(.value)"' 2>/dev/null)" || true
  if [[ -z "$recorded_entries" ]]; then
    printf 'backlog-unapproved:no-approval'
    return 0
  fi

  mapfile -t listing < <(backlog_listing "$repo" "$ref" "$dir")
  while IFS=$'\t' read -r name sha; do
    [[ -n "$name" ]] || continue
    listed["$name"]="$sha"
  done < <(printf '%s\n' "${listing[@]+"${listing[@]}"}")
  while IFS=$'\t' read -r name sha; do
    [[ -n "$name" ]] || continue
    recorded["$name"]="$sha"
  done < <(printf '%s\n' "$recorded_entries")

  for n in "${!recorded[@]}"; do
    all_names+=("$n")
  done
  for n in "${!listed[@]}"; do
    if [[ "$n" == "plan.md" || "$n" == story-*.md ]]; then
      all_names+=("$n")
    fi
  done
  mapfile -t names < <(printf '%s\n' "${all_names[@]}" | LC_ALL=C sort -u)

  for name in "${names[@]}"; do
    rsha="${recorded[$name]:-}"
    lsha="${listed[$name]:-}"
    if [[ -z "$rsha" || -z "$lsha" || "$rsha" != "$lsha" ]]; then
      printf 'backlog-unapproved:files-differ(%s)' "$(safe_field "$name" 48)"
      return 0
    fi
  done

  return 0
}

# run_action <script-name> <args...> — dispatch, unless this is a dry run.
# A failing job must never abort the rest of the pass.
run_action() {
  local script="$1"
  shift
  if ((DRY_RUN)); then
    return 0
  fi
  local rc=0
  ob_log INFO "dispatch ${script} $*"
  "${OB_SELF_DIR}/${script}" "$@" || rc=$?
  if ((rc != 0)); then
    ob_log ERROR "${script} $* exited ${rc}"
  fi
  return 0
}

# mark_blocked <repo> <slug> <pr-or-empty> <attempts> — rule 4's action, made
# idempotent by remembering the attempt count we already reported.
mark_blocked() {
  local repo="$1" slug="$2" pr="$3" attempts="$4" marker reported
  if ((DRY_RUN)); then
    return 0
  fi
  marker="$(ob_state_dir "$repo" "$slug")/blocked-reported"
  reported=""
  if [[ -s "$marker" ]]; then
    reported="$(tr -dc '0-9' <"$marker")"
  fi
  if [[ "$reported" == "$attempts" ]]; then
    return 0
  fi
  ob_log WARN "attempt budget exhausted for ${repo} ${slug} (${attempts}/${MAX_ATTEMPTS})"
  ob_report_blocked "$repo" "$slug" "$pr" \
    "The attempt budget is exhausted (${attempts} of ${MAX_ATTEMPTS} rounds used). openbuilder will not touch this slug again. To hand it back to the agent, on the instance run: \`printf '0\\n' > $(ob_state_dir "$repo" "$slug")/attempts\` and delete \`${marker}\`."
  printf '%s\n' "$attempts" >"$marker"
}

# evaluate <owner/repo> <slug> — the §6 table, in order, first match wins,
# at most one action per slug per pass.
evaluate() {
  local repo="$1" slug="$2"
  local key work_branch pr labels attempts reason

  key="$(ob_slug_key "$repo" "$slug")"
  work_branch="${OPENBUILDER_BRANCH_PREFIX}/work/${slug}"

  # --- Rule 1: a lock for this slug is held -> a job is already running.
  if ob_lock_held "$key"; then
    decision "$repo" "$slug" 1 skip "lock-held"
    return 0
  fi

  pr="$(ob_pr_number "$repo" "$work_branch" all)"
  labels=" "
  if [[ -n "$pr" ]]; then
    labels="$(ob_pr_labels "$repo" "$pr")"
  fi

  # --- Rule 2: PR exists and is approved -> skip forever.
  if [[ -n "$pr" ]] && ob_has_label "$labels" approved; then
    decision "$repo" "$slug" 2 skip "approved(pr=${pr})"
    return 0
  fi

  # --- Rule 3: PR exists and is blocked -> skip forever.
  if [[ -n "$pr" ]] && ob_has_label "$labels" blocked; then
    decision "$repo" "$slug" 3 skip "blocked(pr=${pr})"
    return 0
  fi

  # --- Rule 4: attempts counter >= OPENBUILDER_MAX_ATTEMPTS -> block, comment.
  attempts="$(ob_attempts_get "$repo" "$slug")"
  if ((attempts >= MAX_ATTEMPTS)); then
    decision "$repo" "$slug" 4 block "attempts=${attempts}/${MAX_ATTEMPTS}"
    mark_blocked "$repo" "$slug" "$pr" "$attempts"
    return 0
  fi

  # --- Rule 4b: plan branch present, no PR, backlog not approved -> skip quietly.
  if [[ -z "$pr" ]]; then
    reason="$(backlog_decline_reason "$repo" "$slug")"
    if [[ -n "$reason" ]]; then
      decision "$repo" "$slug" 4b skip "$reason"
      return 0
    fi
  fi

  # --- Rule 5: no PR with head <prefix>/work/<slug> -> implement.
  if [[ -z "$pr" ]]; then
    decision "$repo" "$slug" 5 implement "no-pr attempts=${attempts}"
    ACTIONABLE=$((ACTIONABLE + 1))
    run_action ob-implement "$repo" "$slug"
    return 0
  fi

  # --- Rule 6: PR exists and the reviewer requested changes -> respond.
  if ob_has_label "$labels" changes-requested; then
    decision "$repo" "$slug" 6 respond "pr=${pr} attempts=${attempts}"
    ACTIONABLE=$((ACTIONABLE + 1))
    run_action ob-respond "$repo" "$slug" "$pr"
    return 0
  fi

  # --- Rule 7: otherwise -> waiting on the human reviewer.
  decision "$repo" "$slug" 7 skip "awaiting-reviewer(pr=${pr})"
}

poll_repo() {
  local repo="$1"
  local -a refs=()
  local ref slug prefix
  prefix="refs/heads/${OPENBUILDER_BRANCH_PREFIX}/plan/"

  mapfile -t refs < <(list_plan_refs "$repo")
  if ((${#refs[@]} == 0)); then
    decision "$repo" "-" "-" skip "no-plan-branches"
    return 0
  fi
  for ref in "${refs[@]}"; do
    slug="${ref#"$prefix"}"
    if [[ ! "$slug" =~ ^[a-z0-9][a-z0-9-]{1,48}$ ]]; then
      decision "$repo" "${slug:--}" "-" skip "invalid-slug"
      continue
    fi
    evaluate "$repo" "$slug"
  done
}

main() {
  while (($# > 0)); do
    case "$1" in
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    -h | --help)
      usage
      return 0
      ;;
    *)
      usage >&2
      ob_die "unknown argument: $1"
      ;;
    esac
  done

  ob_load_env
  MAX_ATTEMPTS="${OPENBUILDER_MAX_ATTEMPTS//[^0-9]/}"
  MAX_ATTEMPTS="${MAX_ATTEMPTS:-6}"

  # A real pass takes the global lock so passes never overlap. A dry run takes
  # no lock: it changes nothing, and blocking on the live pass would make
  # ob-idle-stop misread a busy instance as an idle one.
  if ((DRY_RUN == 0)); then
    if ! ob_lock poll; then
      decision "-" "-" "-" skip "poll-lock-held"
      printf 'ACTIONABLE=0\n'
      return 0
    fi
  fi

  local -a repos=()
  mapfile -t repos < <(ob_repos)
  if ((${#repos[@]} == 0)); then
    decision "-" "-" "-" skip "no-repos-configured"
    printf 'ACTIONABLE=0\n'
    return 0
  fi

  local repo
  for repo in "${repos[@]}"; do
    if [[ ! "$repo" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]]; then
      decision "$repo" "-" "-" skip "invalid-repo"
      continue
    fi
    if ((DRY_RUN == 0)); then
      ob_ensure_labels "$repo"
    fi
    poll_repo "$repo"
  done

  printf 'ACTIONABLE=%d\n' "$ACTIONABLE"
}

main "$@"
