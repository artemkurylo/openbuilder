#!/usr/bin/env bash
# ob-token — mint a GitHub App installation access token and print ONLY that
# token on stdout. Single responsibility: GitHub identity for the box.
#
# Everything else (gh, git credential helper, omp's github tool) gets its
# credential from here, so the JWT signing and the caching live in exactly one
# place. The token is never logged; the PEM never touches a non-0600 file.
set -euo pipefail
IFS=$'\n\t'

# shellcheck disable=SC2034  # consumed by ob-common.sh's ob_log prefix after sourcing
OB_PROG="ob-token"
OB_SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./ob-common.sh
source "${OB_SELF_DIR}/ob-common.sh"

# Temporary files holding the private key and the curl config (both 0600).
OB_PEM_FILE=""
OB_CURL_CFG=""

ob_token_cleanup() {
  if [[ -n "$OB_PEM_FILE" ]]; then
    rm -f "$OB_PEM_FILE"
  fi
  if [[ -n "$OB_CURL_CFG" ]]; then
    rm -f "$OB_CURL_CFG"
  fi
  return 0
}
trap ob_token_cleanup EXIT INT TERM

# base64url — RFC 7515 base64url, no padding, single line.
base64url() {
  openssl base64 -A | tr '+/' '-_' | tr -d '='
}

# cached_token — print a still-valid cached token, or fail.
# "Still valid" means more than five minutes remain before expires_at.
cached_token() {
  local cache exp exp_epoch now_epoch token
  cache="${OPENBUILDER_HOME}/cache/gh-token.json"
  [[ -s "$cache" ]] || return 1
  exp="$(jq -r '.expires_at // empty' <"$cache" 2>/dev/null || printf '')"
  [[ -n "$exp" ]] || return 1
  exp_epoch="$(date -u -d "$exp" +%s 2>/dev/null || printf '')"
  [[ -n "$exp_epoch" ]] || return 1
  now_epoch="$(date -u +%s)"
  ((exp_epoch - now_epoch > 300)) || return 1
  token="$(jq -r '.token // empty' <"$cache" 2>/dev/null || printf '')"
  [[ -n "$token" ]] || return 1
  printf '%s' "$token"
}

# app_jwt — RS256 JWT signed with the App private key: iat=now-60, exp=now+540.
app_jwt() {
  local app_id="$1"
  local now header payload signing_input signature
  now="$(date -u +%s)"
  header="$(jq -cn '{alg:"RS256",typ:"JWT"}')"
  payload="$(jq -cn \
    --argjson iat "$((now - 60))" \
    --argjson exp "$((now + 540))" \
    --arg iss "$app_id" \
    '{iat:$iat,exp:$exp,iss:$iss}')"
  signing_input="$(printf '%s' "$header" | base64url).$(printf '%s' "$payload" | base64url)"
  signature="$(printf '%s' "$signing_input" |
    openssl dgst -sha256 -sign "$OB_PEM_FILE" -binary | base64url)"
  printf '%s.%s' "$signing_input" "$signature"
}

# write_cache <response-json> — store {token, expires_at} at mode 0600, atomically.
write_cache() {
  local response="$1" cache tmp
  cache="${OPENBUILDER_HOME}/cache/gh-token.json"
  tmp="${cache}.new"
  (
    umask 077
    printf '%s' "$response" |
      jq -c '{token:.token, expires_at:.expires_at}' >"$tmp"
  )
  chmod 0600 "$tmp"
  mv -f "$tmp" "$cache"
}

mint_token() {
  local app_id install_id jwt response token message
  app_id="$(ob_ssm github_app_id)" || ob_die "cannot read github_app_id"
  install_id="$(ob_ssm github_app_installation_id)" ||
    ob_die "cannot read github_app_installation_id"

  OB_PEM_FILE="$(mktemp "${TMPDIR:-/tmp}/ob-pem.XXXXXXXX")"
  chmod 0600 "$OB_PEM_FILE"
  ob_ssm github_app_private_key >"$OB_PEM_FILE" ||
    ob_die "cannot read github_app_private_key"

  jwt="$(app_jwt "$app_id")"

  # The JWT is a credential, so it goes into a 0600 curl config file rather than
  # argv, where any local process could read it out of /proc.
  OB_CURL_CFG="$(mktemp "${TMPDIR:-/tmp}/ob-curl.XXXXXXXX")"
  chmod 0600 "$OB_CURL_CFG"
  {
    printf 'request = "POST"\n'
    printf 'silent\n'
    printf 'show-error\n'
    printf 'fail-with-body\n'
    printf 'header = "Authorization: Bearer %s"\n' "$jwt"
    printf 'header = "Accept: application/vnd.github+json"\n'
    printf 'header = "X-GitHub-Api-Version: 2022-11-28"\n'
    printf 'url = "https://api.github.com/app/installations/%s/access_tokens"\n' \
      "$install_id"
  } >"$OB_CURL_CFG"

  response="$(curl --config "$OB_CURL_CFG")" ||
    ob_die "GitHub App token request failed (HTTP error)"

  token="$(printf '%s' "$response" | jq -r '.token // empty' 2>/dev/null || printf '')"
  if [[ -z "$token" ]]; then
    message="$(printf '%s' "$response" |
      jq -r '.message // "unparseable response"' 2>/dev/null || printf 'unparseable response')"
    ob_die "GitHub App token mint failed: ${message}"
  fi

  write_cache "$response"
  printf '%s\n' "$token"
}

main() {
  ob_load_env
  local token
  if token="$(cached_token)"; then
    printf '%s\n' "$token"
    return 0
  fi
  # Called directly, NOT in a command substitution: mint_token must be able to
  # ob_die and take the whole script down instead of a subshell.
  mint_token
}

main "$@"
