# --- Terraform ------------------------------------------------------------
# State is local (see infra/versions.tf for the commented S3+DynamoDB backend).
# It contains resource metadata and must never be committed.
.terraform/
.terraform.tfstate.lock.info
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# The provider lock file IS tracked on purpose — it pins provider hashes.
!.terraform.lock.hcl

# Variable files hold account ids, emails and repo lists. Only the example
# is tracked.
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# --- Operator-local config ------------------------------------------------
# Sourced by local/bin/openbuilder. Machine-specific instance id, region and
# default repo. Never committed.
.openbuilder.local

# --- Secrets --------------------------------------------------------------
# The GitHub App private key, and anything else key-shaped.
*.pem
*.p12
*.pfx
*.key
id_rsa
id_ed25519

# --- Agent run artifacts --------------------------------------------------
# omp --mode json output, pulled off the box for debugging. Contains prompts,
# diffs and token costs.
*.ndjson

# --- OS and editors -------------------------------------------------------
.DS_Store
.AppleDouble
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
